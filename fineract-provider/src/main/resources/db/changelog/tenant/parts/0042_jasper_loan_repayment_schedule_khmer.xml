<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Khmer repayment schedule (ITD-0002 layout), printed from the loan account; runs from reports/loan-repayment-schedule-khmer.jrxml.
         use_report is false: it needs a specific loan (R_loanId), so it is not listed in the Reports tab -->
    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM stretchy_report WHERE report_name = 'Loan Repayment Schedule Khmer'</sqlCheck>
        </preConditions>
        <insert tableName="stretchy_report">
            <column name="report_name" value="Loan Repayment Schedule Khmer"/>
            <column name="report_type" value="Jasper"/>
            <column name="report_category" value="Loan"/>
            <column name="description" value="Khmer repayment schedule for a single loan (R_loanId)"/>
            <column name="core_report" valueBoolean="false"/>
            <column name="use_report" valueBoolean="false"/>
            <column name="self_service_user_report" valueBoolean="false"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code = 'READ_Loan Repayment Schedule Khmer'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="report"/>
            <column name="code" value="READ_Loan Repayment Schedule Khmer"/>
            <column name="entity_name" value="Loan Repayment Schedule Khmer"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
