    <!-- The Table SQL of "Loans Pending Approval" never filtered on fund: stop prompting for it -->
    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="1">SELECT COUNT(*) FROM stretchy_report_parameter srp JOIN stretchy_report sr ON sr.id = srp.report_id JOIN stretchy_parameter sp ON sp.id = srp.parameter_id WHERE sr.report_name = 'Loans Pending Approval(Pentaho)' AND sp.parameter_variable = 'fundId'</sqlCheck>
        </preConditions>
        <delete tableName="stretchy_report_parameter">
            <where>report_id = (SELECT sr.id FROM stretchy_report sr WHERE sr.report_name = 'Loans Pending Approval(Pentaho)') AND parameter_id = (SELECT sp.id FROM stretchy_parameter sp WHERE sp.parameter_name = 'fundIdSelectAll')</where>
        </delete>
    </changeSet>

