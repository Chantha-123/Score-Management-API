    <!-- Loan portfolio "(Pentaho)" reports (no Pentaho plugin is installed) now run from reports/<slug>.jrxml, with the SQL of
         the Table report of the same name rewritten for MySQL and PostgreSQL -->
    <changeSet author="fineract" id="1">
        <update tableName="stretchy_report">
            <column name="report_type" value="Jasper"/>
            <!-- Report.validate rejects report_sql on non-Table/Chart types -->
            <column name="report_sql" valueComputed="NULL"/>
            <column name="report_category" value="Fund"/>
            <column name="description" value="Principal disbursed in a period by fund and currency (R_currencyId, R_fundId, R_startDate, R_endDate)"/>
            <where>report_name = 'Funds Disbursed Between Dates Summary(Pentaho)'</where>
        </update>
        <update tableName="stretchy_report">
            <column name="report_type" value="Jasper"/>
            <!-- Report.validate rejects report_sql on non-Table/Chart types -->
