<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- Khmer copy of the loan receipt for testing Khmer Unicode output; runs from reports/loan-transaction-receipt-khmer.jrxml -->
    <changeSet author="fineract" id="1">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM stretchy_report WHERE report_name = 'Loan Transaction Receipt Khmer'</sqlCheck>
        </preConditions>
        <insert tableName="stretchy_report">
            <column name="report_name" value="Loan Transaction Receipt Khmer"/>
            <column name="report_type" value="Jasper"/>
            <column name="report_category" value="Loan"/>
            <column name="description" value="Khmer payment receipt for a single loan transaction (R_transactionId)"/>
            <column name="core_report" valueBoolean="false"/>
            <column name="use_report" valueBoolean="true"/>
            <column name="self_service_user_report" valueBoolean="false"/>
        </insert>
        <!-- Same transactionId text parameter as "Loan Transaction Receipt", so the Run Reports screen shows the input -->
        <insert tableName="stretchy_report_parameter">
            <column name="report_id" valueComputed="(SELECT id FROM stretchy_report WHERE report_name = 'Loan Transaction Receipt Khmer')"/>
            <column name="parameter_id" valueComputed="(SELECT id FROM stretchy_parameter WHERE parameter_name = 'transactionId')"/>
            <column name="report_parameter_name" value="transactionId"/>
        </insert>
    </changeSet>

    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code = 'READ_Loan Transaction Receipt Khmer'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="report"/>
            <column name="code" value="READ_Loan Transaction Receipt Khmer"/>
            <column name="entity_name" value="Loan Transaction Receipt Khmer"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
