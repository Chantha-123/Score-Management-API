<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <!--
        Collateral item types no longer carry a valuation (base price / percentage to base): collateral is a record of
        what was pledged, and the loan principal is no longer limited by it. The columns are kept (existing rows keep
        their legacy values) but are no longer written, so they must accept NULL.
    -->
    <changeSet author="fineract" id="collateral-base-price-nullable">
        <dropNotNullConstraint tableName="m_collateral_management" columnName="base_price" columnDataType="DECIMAL(20, 5)"/>
    </changeSet>
    <changeSet author="fineract" id="collateral-pct-to-base-nullable">
        <dropNotNullConstraint tableName="m_collateral_management" columnName="pct_to_base" columnDataType="DECIMAL(20, 5)"/>
    </changeSet>
</databaseChangeLog>
