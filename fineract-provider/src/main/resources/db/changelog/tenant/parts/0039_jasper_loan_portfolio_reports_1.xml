    <!-- Loan portfolio reports, batch 1: the "(Pentaho)" twins (no Pentaho plugin installed) now run from Jasper templates,
         reports/<slug>.jrxml, built from the SQL of the Table report of the same name. Their stretchy_report_parameter rows
         already match the template parameters, so they are kept as they are. -->
    <changeSet author="fineract" id="1">
        <!-- reports/active-loans-details-pentaho.jrxml -->
        <update tableName="stretchy_report">
            <column name="report_type" value="Jasper"/>
            <!-- Report.validate rejects report_sql on non-Table/Chart types (the twins held the text '(NULL)') -->
            <column name="report_sql" valueComputed="NULL"/>
            <column name="report_category" value="Loan"/>
            <column name="description" value="Active loans with repaid, outstanding and overdue amounts by office and currency (R_officeId, R_loanOfficerId, R_currencyId, R_fundId, R_loanProductId, R_loanPurposeId)"/>
            <where>report_name = 'Active Loans - Details(Pentaho)'</where>
        </update>
        <!-- reports/active-loans-summary-pentaho.jrxml -->
        <update tableName="stretchy_report">
            <column name="report_type" value="Jasper"/>
            <!-- Report.validate rejects report_sql on non-Table/Chart types (the twins held the text '(NULL)') -->
