            <column name="report_category" value="Loan"/>
            <column name="description" value="Active loan totals and portfolio at risk per office, by currency (R_officeId, R_loanOfficerId, R_currencyId, R_fundId, R_loanProductId, R_loanPurposeId, R_parType)"/>
            <where>report_name = 'Active Loans - Summary(Pentaho)'</where>
