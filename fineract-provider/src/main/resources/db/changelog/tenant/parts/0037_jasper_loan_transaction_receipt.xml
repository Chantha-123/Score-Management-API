<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">

    <!-- The receipt was a Pentaho report with no Pentaho plugin installed; it now runs from reports/loan-transaction-receipt.jrxml -->
    <changeSet author="fineract" id="1">
        <update tableName="stretchy_report">
            <column name="report_type" value="Jasper"/>
            <column name="report_category" value="Loan"/>
            <column name="description" value="Payment receipt for a single loan transaction (R_transactionId)"/>
            <where>report_name = 'Loan Transaction Receipt'</where>
        </update>
    </changeSet>

    <changeSet author="fineract" id="2">
        <preConditions onFail="MARK_RAN">
            <sqlCheck expectedResult="0">SELECT COUNT(*) FROM m_permission WHERE code = 'READ_Loan Transaction Receipt'</sqlCheck>
        </preConditions>
        <insert tableName="m_permission">
            <column name="grouping" value="report"/>
            <column name="code" value="READ_Loan Transaction Receipt"/>
            <column name="entity_name" value="Loan Transaction Receipt"/>
            <column name="action_name" value="READ"/>
            <column name="can_maker_checker" valueBoolean="false"/>
        </insert>
    </changeSet>
</databaseChangeLog>
