<!-- Stretchy report "Active Loans Passed Final Maturity(Pentaho)" (report_type = Jasper), converted from the SQL of the Table report "Active Loans Passed Final Maturity".
     Run with R_officeId, R_loanOfficerId, R_currencyId, R_fundId, R_loanProductId, R_loanPurposeId (-1 = All, -10 = none/blank for officer, fund and purpose). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="active-loans-passed-final-maturity-pentaho" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

    <!-- Names may be Khmer: lay out Khmer runs with Java's text engine (OpenPDF cannot shape them) -->
    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>
    <!-- CSV/XLSX: keep only column headers, detail rows and totals (no repeated titles / page footers) -->
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.title" value="title"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>

    <!-- Font set from fonts/battambang/fonts.xml: DejaVu Sans, with Battambang for Khmer characters.
         Battambang lines need about 2x the font size in height, so 8pt rows are 18pt tall. -->
    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="8" isBlankWhenNull="true">
        <box leftPadding="2" rightPadding="2"/>
    </style>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>
    <style name="ColumnHeader" style="Base" isBold="true" mode="Opaque" backcolor="#E6E6E6" vTextAlign="Middle"/>
    <style name="Amount" style="Base" hTextAlign="Right" pattern="#,##0.00"/>
    <style name="Total" style="Amount" isBold="true"/>
    <style name="Count" style="Base" hTextAlign="Right" pattern="#,##0"/>
    <style name="TotalCount" style="Count" isBold="true"/>

    <!-- Supplied by the service on every run -->
    <parameter name="currentDate" class="java.util.Date"/>
    <parameter name="currentDateTime" class="java.util.Date"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>
    <!-- Stretchy parameter variables; defaults apply when the R_ value is missing or blank -->
    <parameter name="officeId" class="java.lang.Long">
        <!-- OfficeIdSelectOne has no "All": default to the head office (root of the hierarchy) -->
        <defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanOfficerId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="currencyId" class="java.lang.String">
        <defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
    </parameter>
    <parameter name="fundId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanProductId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanPurposeId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
SELECT (SELECT so.name FROM m_office so WHERE so.id = $P{officeId}) AS selected_office_name,
       (SELECT ss.display_name FROM m_staff ss WHERE ss.id = $P{loanOfficerId}) AS selected_loan_officer,
       (SELECT sp.name FROM m_product_loan sp WHERE sp.id = $P{loanProductId}) AS selected_loan_product,
       (SELECT sf.name FROM m_fund sf WHERE sf.id = $P{fundId}) AS selected_fund,
       (SELECT sc.code_value FROM m_code_value sc WHERE sc.id = $P{loanPurposeId}) AS selected_loan_purpose,
       ounder.id AS office_id,
       CONCAT(REPEAT('..', LENGTH(ounder.hierarchy) - LENGTH(REPLACE(ounder.hierarchy, '.', '')) - 1), ounder.name) AS office_name,
       l.currency_code,
       COALESCE(cur.display_symbol, l.currency_code) AS currency,
       lo.display_name AS loan_officer_name,
       c.account_no AS client_account_no,
       c.display_name AS client_name,
       l.account_no AS loan_account_no,
       pl.name AS product_name,
       f.name AS fund_name,
       l.principal_amount AS loan_amount,
       l.annual_nominal_interest_rate AS annual_interest_rate,
       l.disbursedon_date AS disbursed_on,
       l.expected_maturedon_date AS expected_matured_on,
       l.principal_repaid_derived AS principal_repaid,
       l.principal_outstanding_derived AS principal_outstanding,
       laa.principal_overdue_derived AS principal_overdue,
       l.interest_repaid_derived AS interest_repaid,
       l.interest_outstanding_derived AS interest_outstanding,
       laa.interest_overdue_derived AS interest_overdue,
       l.fee_charges_repaid_derived AS fees_repaid,
       l.fee_charges_outstanding_derived AS fees_outstanding,
       laa.fee_charges_overdue_derived AS fees_overdue,
       l.penalty_charges_repaid_derived AS penalties_repaid,
       l.penalty_charges_outstanding_derived AS penalties_outstanding,
       laa.penalty_charges_overdue_derived AS penalties_overdue
FROM m_office o
JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
                    AND ounder.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
JOIN m_client c ON c.office_id = ounder.id
JOIN m_loan l ON l.client_id = c.id
JOIN m_product_loan pl ON pl.id = l.product_id
LEFT JOIN m_staff lo ON lo.id = l.loan_officer_id
LEFT JOIN m_currency cur ON cur.code = l.currency_code
LEFT JOIN m_fund f ON f.id = l.fund_id
LEFT JOIN m_loan_arrears_aging laa ON laa.loan_id = l.id
WHERE o.id = $P{officeId}
  AND ($P{currencyId} = '-1' OR l.currency_code = $P{currencyId})
  AND ($P{loanProductId} = -1 OR l.product_id = $P{loanProductId})
  AND ($P{loanOfficerId} = -1 OR COALESCE(l.loan_officer_id, -10) = $P{loanOfficerId})
  AND ($P{fundId} = -1 OR COALESCE(l.fund_id, -10) = $P{fundId})
  AND ($P{loanPurposeId} = -1 OR COALESCE(l.loanpurpose_cv_id, -10) = $P{loanPurposeId})
  AND l.loan_status_id = 300
  AND l.expected_maturedon_date < $P{currentDate}
ORDER BY ounder.hierarchy, l.currency_code, c.account_no, l.account_no
        ]]>
    </queryString>

    <!-- Field names = SQL aliases, lowercase snake_case (PostgreSQL folds unquoted aliases to lowercase) -->
    <field name="selected_office_name" class="java.lang.String"/>
    <field name="selected_loan_officer" class="java.lang.String"/>
    <field name="selected_loan_product" class="java.lang.String"/>
    <field name="selected_fund" class="java.lang.String"/>
    <field name="selected_loan_purpose" class="java.lang.String"/>
    <field name="office_id" class="java.lang.Long"/>
    <field name="office_name" class="java.lang.String"/>
    <field name="currency_code" class="java.lang.String"/>
    <field name="currency" class="java.lang.String"/>
    <field name="client_account_no" class="java.lang.String"/>
    <field name="client_name" class="java.lang.String"/>
    <field name="loan_account_no" class="java.lang.String"/>
    <field name="product_name" class="java.lang.String"/>
    <field name="fund_name" class="java.lang.String"/>
    <field name="loan_officer_name" class="java.lang.String"/>
    <field name="loan_amount" class="java.math.BigDecimal"/>
    <field name="annual_interest_rate" class="java.math.BigDecimal"/>
    <field name="disbursed_on" class="java.util.Date"/>
    <field name="expected_matured_on" class="java.util.Date"/>
    <field name="principal_repaid" class="java.math.BigDecimal"/>
    <field name="principal_outstanding" class="java.math.BigDecimal"/>
    <field name="principal_overdue" class="java.math.BigDecimal"/>
    <field name="interest_repaid" class="java.math.BigDecimal"/>
    <field name="interest_outstanding" class="java.math.BigDecimal"/>
    <field name="interest_overdue" class="java.math.BigDecimal"/>
    <field name="fees_repaid" class="java.math.BigDecimal"/>
    <field name="fees_outstanding" class="java.math.BigDecimal"/>
    <field name="fees_overdue" class="java.math.BigDecimal"/>
    <field name="penalties_repaid" class="java.math.BigDecimal"/>
    <field name="penalties_outstanding" class="java.math.BigDecimal"/>
    <field name="penalties_overdue" class="java.math.BigDecimal"/>

    <variable name="grandLoanAmount" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{loan_amount}]]></variableExpression>
    </variable>
    <variable name="grandPrincipalRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_repaid}]]></variableExpression>
    </variable>
    <variable name="grandPrincipalOutstanding" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_outstanding}]]></variableExpression>
    </variable>
    <variable name="grandPrincipalOverdue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_overdue}]]></variableExpression>
    </variable>
    <variable name="grandInterestRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_repaid}]]></variableExpression>
    </variable>
    <variable name="grandInterestOutstanding" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_outstanding}]]></variableExpression>
    </variable>
    <variable name="grandInterestOverdue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_overdue}]]></variableExpression>
    </variable>
    <variable name="grandFeesRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_repaid}]]></variableExpression>
    </variable>
    <variable name="grandFeesOutstanding" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_outstanding}]]></variableExpression>
    </variable>
    <variable name="grandFeesOverdue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_overdue}]]></variableExpression>
    </variable>
    <variable name="grandPenaltiesRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{penalties_repaid}]]></variableExpression>
    </variable>
    <variable name="grandPenaltiesOutstanding" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{penalties_outstanding}]]></variableExpression>
    </variable>
    <variable name="grandPenaltiesOverdue" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{penalties_overdue}]]></variableExpression>
    </variable>
    <variable name="groupLoanAmount" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{loan_amount}]]></variableExpression>
    </variable>
    <variable name="groupPrincipalRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_repaid}]]></variableExpression>
    </variable>
    <variable name="groupPrincipalOutstanding" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_outstanding}]]></variableExpression>
    </variable>
    <variable name="groupPrincipalOverdue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_overdue}]]></variableExpression>
    </variable>
    <variable name="groupInterestRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_repaid}]]></variableExpression>
    </variable>
    <variable name="groupInterestOutstanding" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_outstanding}]]></variableExpression>
    </variable>
    <variable name="groupInterestOverdue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_overdue}]]></variableExpression>
    </variable>
    <variable name="groupFeesRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_repaid}]]></variableExpression>
    </variable>
    <variable name="groupFeesOutstanding" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_outstanding}]]></variableExpression>
    </variable>
    <variable name="groupFeesOverdue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_overdue}]]></variableExpression>
    </variable>
    <variable name="groupPenaltiesRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{penalties_repaid}]]></variableExpression>
    </variable>
    <variable name="groupPenaltiesOutstanding" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{penalties_outstanding}]]></variableExpression>
    </variable>
    <variable name="groupPenaltiesOverdue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{penalties_overdue}]]></variableExpression>
    </variable>

    <group name="officeCurrency">
        <groupExpression><![CDATA[$F{office_id} + "|" + $F{currency_code}]]></groupExpression>
        <groupHeader>
            <band height="22">
                <textField>
                    <reportElement style="Value" x="0" y="2" width="802" height="18"/>
                    <textFieldExpression><![CDATA[$F{office_name} + "  (" + $F{currency} + ")"]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
        <band height="40">
                <line>
                    <reportElement x="0" y="1" width="802" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="2" width="545" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Subtotal " + $F{office_name} + " (" + $F{currency} + "), " + $V{officeCurrency_COUNT} + " loans"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="545" y="2" width="75" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupLoanAmount}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="0" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupPrincipalRepaid}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="67" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupPrincipalOutstanding}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="134" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupPrincipalOverdue}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="201" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupInterestRepaid}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="268" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupInterestOutstanding}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="335" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupInterestOverdue}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="402" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupFeesRepaid}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="469" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupFeesOutstanding}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="536" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupFeesOverdue}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="603" y="20" width="67" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupPenaltiesRepaid}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="670" y="20" width="66" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupPenaltiesOutstanding}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="736" y="20" width="66" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupPenaltiesOverdue}]]></textFieldExpression>
                </textField>
        </band>
        </groupFooter>
    </group>

    <title>
        <band height="110">
            <staticText>
                <reportElement x="0" y="0" width="802" height="24"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Active Loans Passed Final Maturity]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="0" y="26" width="80" height="18"/>
                <text><![CDATA[Office]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="26" width="311" height="18"/>
                <textFieldExpression><![CDATA[$F{selected_office_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="401" y="26" width="80" height="18"/>
                <text><![CDATA[Currency]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="481" y="26" width="311" height="18"/>
                <textFieldExpression><![CDATA["-1".equals($P{currencyId}) ? "All" : $P{currencyId}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="46" width="80" height="18"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="46" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{loanOfficerId} == -1L ? "All" : ($P{loanOfficerId} == -10L ? "None" : $F{selected_loan_officer})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="401" y="46" width="80" height="18"/>
                <text><![CDATA[Product]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="481" y="46" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{loanProductId} == -1L ? "All" : $F{selected_loan_product}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="66" width="80" height="18"/>
                <text><![CDATA[Fund]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="66" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{fundId} == -1L ? "All" : ($P{fundId} == -10L ? "None" : $F{selected_fund})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="401" y="66" width="80" height="18"/>
                <text><![CDATA[Loan Purpose]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="481" y="66" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{loanPurposeId} == -1L ? "All" : ($P{loanPurposeId} == -10L ? "None" : $F{selected_loan_purpose})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="86" width="80" height="18"/>
                <text><![CDATA[As of]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="86" width="311" height="18"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{currentDate})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="44">
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="0" width="60" height="22"/>
                <text><![CDATA[Client Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="60" y="0" width="150" height="22"/>
                <text><![CDATA[Client]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="210" y="0" width="65" height="22"/>
                <text><![CDATA[Loan Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="275" y="0" width="105" height="22"/>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="380" y="0" width="60" height="22"/>
                <text><![CDATA[Fund]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="440" y="0" width="105" height="22"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="545" y="0" width="75" height="22"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Loan Amount]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="620" y="0" width="42" height="22"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Annual Rate %]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="662" y="0" width="65" height="22"/>
                <text><![CDATA[Disbursed]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="727" y="0" width="75" height="22"/>
                <text><![CDATA[Expected Maturity]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="22" width="67" height="22"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Principal Repaid]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="67" y="22" width="67" height="22"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Principal Outstanding]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="134" y="22" width="67" height="22"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Principal Overdue]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="201" y="22" width="67" height="22"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Interest Repaid]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="268" y="22" width="67" height="22"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Interest Outstanding]]></text>
            </staticText>
            <staticText>
