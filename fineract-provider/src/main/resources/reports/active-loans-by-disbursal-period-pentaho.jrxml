<!-- Stretchy report "Active Loans by Disbursal Period(Pentaho)" (report_type = Jasper), converted from the SQL of the Table report "Active Loans by Disbursal Period".
     Run with R_officeId, R_loanOfficerId, R_currencyId, R_fundId, R_loanProductId, R_loanPurposeId, R_startDate, R_endDate (yyyy-MM-dd) (-1 = All, -10 = none/blank for officer, fund and purpose). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="active-loans-by-disbursal-period-pentaho" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

    <!-- Names may be Khmer: lay out Khmer runs with Java's text engine (OpenPDF cannot shape them) -->
    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>
    <!-- CSV/XLSX: keep only column headers, detail rows and totals (no repeated titles / page footers) -->
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.title" value="title"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>

    <!-- Font set from fonts/battambang/fonts.xml: DejaVu Sans, with Battambang for Khmer characters.
         Battambang lines need about 2x the font size in height, so 8pt rows are 18pt tall. -->
    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="8" isBlankWhenNull="true">
        <box leftPadding="2" rightPadding="2"/>
    </style>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>
    <style name="ColumnHeader" style="Base" isBold="true" mode="Opaque" backcolor="#E6E6E6" vTextAlign="Middle"/>
    <style name="Amount" style="Base" hTextAlign="Right" pattern="#,##0.00"/>
    <style name="Total" style="Amount" isBold="true"/>
    <style name="Count" style="Base" hTextAlign="Right" pattern="#,##0"/>
    <style name="TotalCount" style="Count" isBold="true"/>

    <!-- Supplied by the service on every run -->
    <parameter name="currentDate" class="java.util.Date"/>
    <parameter name="currentDateTime" class="java.util.Date"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>
    <!-- Stretchy parameter variables; defaults apply when the R_ value is missing or blank -->
    <parameter name="officeId" class="java.lang.Long">
        <!-- OfficeIdSelectOne has no "All": default to the head office (root of the hierarchy) -->
        <defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanOfficerId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="currencyId" class="java.lang.String">
        <defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
    </parameter>
    <parameter name="fundId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanProductId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanPurposeId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="startDate" class="java.util.Date">
        <!-- First day of the business month -->
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(new java.sql.Date($P{currentDate}.getTime()).toLocalDate().withDayOfMonth(1))]]></defaultValueExpression>
    </parameter>
    <parameter name="endDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[$P{currentDate}]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
SELECT (SELECT so.name FROM m_office so WHERE so.id = $P{officeId}) AS selected_office_name,
       (SELECT ss.display_name FROM m_staff ss WHERE ss.id = $P{loanOfficerId}) AS selected_loan_officer,
       (SELECT sp.name FROM m_product_loan sp WHERE sp.id = $P{loanProductId}) AS selected_loan_product,
       (SELECT sf.name FROM m_fund sf WHERE sf.id = $P{fundId}) AS selected_fund,
       (SELECT sc.code_value FROM m_code_value sc WHERE sc.id = $P{loanPurposeId}) AS selected_loan_purpose,
       ounder.id AS office_id,
       CONCAT(REPEAT('..', LENGTH(ounder.hierarchy) - LENGTH(REPLACE(ounder.hierarchy, '.', '')) - 1), ounder.name) AS office_name,
       l.currency_code,
       COALESCE(cur.display_symbol, l.currency_code) AS currency,
       c.account_no AS client_account_no,
       c.display_name AS client_name,
       l.account_no AS loan_account_no,
       pl.name AS product_name,
       f.name AS fund_name,
       l.principal_amount AS loan_amount,
       l.annual_nominal_interest_rate AS annual_interest_rate,
       l.disbursedon_date AS disbursed_on,
       l.total_expected_repayment_derived AS total_expected_repayment,
       l.total_repayment_derived AS total_repaid,
       lo.display_name AS loan_officer_name
FROM m_office o
JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
                    AND ounder.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
JOIN m_client c ON c.office_id = ounder.id
JOIN m_loan l ON l.client_id = c.id
JOIN m_product_loan pl ON pl.id = l.product_id
LEFT JOIN m_staff lo ON lo.id = l.loan_officer_id
LEFT JOIN m_currency cur ON cur.code = l.currency_code
LEFT JOIN m_fund f ON f.id = l.fund_id
WHERE o.id = $P{officeId}
  AND ($P{currencyId} = '-1' OR l.currency_code = $P{currencyId})
  AND ($P{loanProductId} = -1 OR l.product_id = $P{loanProductId})
  AND ($P{loanOfficerId} = -1 OR COALESCE(l.loan_officer_id, -10) = $P{loanOfficerId})
  AND ($P{fundId} = -1 OR COALESCE(l.fund_id, -10) = $P{fundId})
  AND ($P{loanPurposeId} = -1 OR COALESCE(l.loanpurpose_cv_id, -10) = $P{loanPurposeId})
  AND l.disbursedon_date BETWEEN $P{startDate} AND $P{endDate}
  AND l.loan_status_id = 300
ORDER BY ounder.hierarchy, l.currency_code, c.account_no, l.account_no
        ]]>
    </queryString>

    <!-- Field names = SQL aliases, lowercase snake_case (PostgreSQL folds unquoted aliases to lowercase) -->
    <field name="selected_office_name" class="java.lang.String"/>
    <field name="selected_loan_officer" class="java.lang.String"/>
    <field name="selected_loan_product" class="java.lang.String"/>
    <field name="selected_fund" class="java.lang.String"/>
    <field name="selected_loan_purpose" class="java.lang.String"/>
    <field name="office_id" class="java.lang.Long"/>
    <field name="office_name" class="java.lang.String"/>
    <field name="currency_code" class="java.lang.String"/>
    <field name="currency" class="java.lang.String"/>
    <field name="client_account_no" class="java.lang.String"/>
    <field name="client_name" class="java.lang.String"/>
    <field name="loan_account_no" class="java.lang.String"/>
    <field name="product_name" class="java.lang.String"/>
    <field name="fund_name" class="java.lang.String"/>
    <field name="loan_officer_name" class="java.lang.String"/>
    <field name="disbursed_on" class="java.util.Date"/>
    <field name="annual_interest_rate" class="java.math.BigDecimal"/>
    <field name="loan_amount" class="java.math.BigDecimal"/>
    <field name="total_expected_repayment" class="java.math.BigDecimal"/>
    <field name="total_repaid" class="java.math.BigDecimal"/>

    <variable name="grandLoanAmount" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{loan_amount}]]></variableExpression>
    </variable>
    <variable name="grandTotalExpectedRepayment" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total_expected_repayment}]]></variableExpression>
    </variable>
    <variable name="grandTotalRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total_repaid}]]></variableExpression>
    </variable>
    <variable name="groupLoanAmount" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{loan_amount}]]></variableExpression>
    </variable>
    <variable name="groupTotalExpectedRepayment" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{total_expected_repayment}]]></variableExpression>
    </variable>
    <variable name="groupTotalRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{total_repaid}]]></variableExpression>
    </variable>

    <group name="officeCurrency">
        <groupExpression><![CDATA[$F{office_id} + "|" + $F{currency_code}]]></groupExpression>
        <groupHeader>
            <band height="22">
                <textField>
                    <reportElement style="Value" x="0" y="2" width="802" height="18"/>
                    <textFieldExpression><![CDATA[$F{office_name} + "  (" + $F{currency} + ")"]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
        <band height="22">
                <line>
                    <reportElement x="0" y="1" width="802" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="2" width="597" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Subtotal " + $F{office_name} + " (" + $F{currency} + "), " + $V{officeCurrency_COUNT} + " loans"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="597" y="2" width="68" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupLoanAmount}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="665" y="2" width="68" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupTotalExpectedRepayment}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="733" y="2" width="69" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupTotalRepaid}]]></textFieldExpression>
                </textField>
        </band>
        </groupFooter>
    </group>

    <title>
        <band height="110">
            <staticText>
                <reportElement x="0" y="0" width="802" height="24"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Active Loans by Disbursal Period]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="0" y="26" width="80" height="18"/>
                <text><![CDATA[Office]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="26" width="311" height="18"/>
                <textFieldExpression><![CDATA[$F{selected_office_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="401" y="26" width="80" height="18"/>
                <text><![CDATA[Currency]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="481" y="26" width="311" height="18"/>
                <textFieldExpression><![CDATA["-1".equals($P{currencyId}) ? "All" : $P{currencyId}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="46" width="80" height="18"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="46" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{loanOfficerId} == -1L ? "All" : ($P{loanOfficerId} == -10L ? "None" : $F{selected_loan_officer})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="401" y="46" width="80" height="18"/>
                <text><![CDATA[Product]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="481" y="46" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{loanProductId} == -1L ? "All" : $F{selected_loan_product}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="66" width="80" height="18"/>
                <text><![CDATA[Fund]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="66" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{fundId} == -1L ? "All" : ($P{fundId} == -10L ? "None" : $F{selected_fund})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="401" y="66" width="80" height="18"/>
                <text><![CDATA[Loan Purpose]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="481" y="66" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{loanPurposeId} == -1L ? "All" : ($P{loanPurposeId} == -10L ? "None" : $F{selected_loan_purpose})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="86" width="80" height="18"/>
                <text><![CDATA[Period]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="86" width="311" height="18"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{startDate}) + " - " + new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{endDate})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="0" width="65" height="24"/>
                <text><![CDATA[Client Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="65" y="0" width="130" height="24"/>
                <text><![CDATA[Client]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="195" y="0" width="70" height="24"/>
                <text><![CDATA[Loan Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="265" y="0" width="90" height="24"/>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="355" y="0" width="55" height="24"/>
                <text><![CDATA[Fund]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="410" y="0" width="95" height="24"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="505" y="0" width="55" height="24"/>
                <text><![CDATA[Disbursed]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="560" y="0" width="37" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Annual Rate %]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="597" y="0" width="68" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Loan Principal]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="665" y="0" width="68" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Total Loan (P+I+F+Pen)]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="733" y="0" width="69" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Total Repaid (P+I+F+Pen)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
                <textField>
                    <reportElement x="0" y="0" width="65" height="18"/>
                    <textFieldExpression><![CDATA[$F{client_account_no}]]></textFieldExpression>
                </textField>
                <textField textAdjust="StretchHeight">
                    <reportElement x="65" y="0" width="130" height="18"/>
                    <textFieldExpression><![CDATA[$F{client_name}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="195" y="0" width="70" height="18"/>
                    <textFieldExpression><![CDATA[$F{loan_account_no}]]></textFieldExpression>
                </textField>
                <textField textAdjust="StretchHeight">
                    <reportElement x="265" y="0" width="90" height="18"/>
                    <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression>
                </textField>
                <textField textAdjust="StretchHeight">
                    <reportElement x="355" y="0" width="55" height="18"/>
                    <textFieldExpression><![CDATA[$F{fund_name}]]></textFieldExpression>
                </textField>
                <textField textAdjust="StretchHeight">
                    <reportElement x="410" y="0" width="95" height="18"/>
                    <textFieldExpression><![CDATA[$F{loan_officer_name}]]></textFieldExpression>
                </textField>
                <textField pattern="dd/MM/yyyy">
                    <reportElement x="505" y="0" width="55" height="18"/>
                    <textFieldExpression><![CDATA[$F{disbursed_on}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="560" y="0" width="37" height="18"/>
                    <textFieldExpression><![CDATA[$F{annual_interest_rate}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="597" y="0" width="68" height="18"/>
                    <textFieldExpression><![CDATA[$F{loan_amount}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="665" y="0" width="68" height="18"/>
                    <textFieldExpression><![CDATA[$F{total_expected_repayment}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="733" y="0" width="69" height="18"/>
                    <textFieldExpression><![CDATA[$F{total_repaid}]]></textFieldExpression>
                </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Label" x="0" y="2" width="300" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Printed by " + $P{currentUserName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd MMM yyyy HH:mm">
                <reportElement style="Label" x="301" y="2" width="200" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{currentDateTime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="602" y="2" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="772" y="2" width="30" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="22">
                <line>
                    <reportElement x="0" y="1" width="802" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="2" width="597" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Grand total, " + $V{REPORT_COUNT} + " loans"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="597" y="2" width="68" height="18">
                        <printWhenExpression><![CDATA[!"-1".equals($P{currencyId})]]></printWhenExpression>
                    </reportElement>
                    <textFieldExpression><![CDATA[$V{grandLoanAmount}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="665" y="2" width="68" height="18">
                        <printWhenExpression><![CDATA[!"-1".equals($P{currencyId})]]></printWhenExpression>
                    </reportElement>
                    <textFieldExpression><![CDATA[$V{grandTotalExpectedRepayment}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="733" y="2" width="69" height="18">
                        <printWhenExpression><![CDATA[!"-1".equals($P{currencyId})]]></printWhenExpression>
                    </reportElement>
                    <textFieldExpression><![CDATA[$V{grandTotalRepaid}]]></textFieldExpression>
                </textField>
        </band>
    </summary>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="802" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11"/></textElement>
                <text><![CDATA[No active loans disbursed in the selected period for the selected office and filters.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
