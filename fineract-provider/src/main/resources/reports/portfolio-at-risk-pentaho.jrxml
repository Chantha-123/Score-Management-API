<!-- Stretchy report "Portfolio at Risk(Pentaho)" (report_type = Jasper).
     Run with R_officeId, R_loanOfficerId, R_currencyId, R_fundId, R_loanProductId, R_loanPurposeId
     (-1 = All; -10 = blank loan officer / fund / purpose), R_parType (1 Principal Only, 2 Principal + Interest,
     3 Principal + Interest + Fees, 4 Principal + Interest + Fees + Penalties). One row per currency of active loans. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="portfolio-at-risk-pentaho" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.title" value="title"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>

    <!-- DejaVu Sans with Battambang for Khmer; rows are at least 2x the font size -->
    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="8"/>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>
    <style name="ColumnHeader" style="Base" isBold="true" mode="Opaque" backcolor="#E6E6E6" vTextAlign="Middle"/>
    <style name="Amount" style="Base" hTextAlign="Right" pattern="#,##0.00"/>
    <style name="Total" style="Amount" isBold="true"/>

    <!-- Supplied by the service on every run -->
    <parameter name="currentDate" class="java.util.Date"/>
    <parameter name="currentDateTime" class="java.util.Date"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>
    <!-- Stretchy parameter variables; defaults apply when the R_ value is missing or blank -->
    <parameter name="officeId" class="java.lang.Long">
        <!-- OfficeIdSelectOne has no "All": default to the head office (root of the hierarchy) -->
        <defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanOfficerId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="currencyId" class="java.lang.String">
        <defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
    </parameter>
    <parameter name="fundId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanProductId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanPurposeId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="parType" class="java.lang.Long">
        <!-- 1 Principal Only, 2 + Interest, 3 + Fees, 4 + Penalties (the stretchy default 0 is "invalid PAR Type") -->
        <defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
SELECT y.selected_office_name,
       (SELECT s.display_name FROM m_staff s WHERE s.id = $P{loanOfficerId}) AS filter_loan_officer,
       (SELECT p.name FROM m_product_loan p WHERE p.id = $P{loanProductId}) AS filter_product,
       (SELECT fu.name FROM m_fund fu WHERE fu.id = $P{fundId}) AS filter_fund,
       (SELECT cv.code_value FROM m_code_value cv WHERE cv.id = $P{loanPurposeId}) AS filter_loan_purpose,
       CASE WHEN $P{parType} = 1 THEN 'Principal Only'
            WHEN $P{parType} = 2 THEN 'Principal + Interest'
            WHEN $P{parType} = 3 THEN 'Principal + Interest + Fees'
            WHEN $P{parType} = 4 THEN 'Principal + Interest + Fees + Penalties'
            ELSE 'invalid PAR Type'
       END AS par_type_name,
       y.currency_code,
       y.currency,
       y.principal_outstanding,
       y.principal_overdue,
       y.interest_outstanding,
       y.interest_overdue,
       y.fees_outstanding,
       y.fees_overdue,
       y.penalties_outstanding,
       y.penalties_overdue,
       y.par_numerator,
       y.par_denominator,
       ROUND(y.par_numerator * 100 / NULLIF(y.par_denominator, 0), 2) AS par_percent
FROM (SELECT x.*,
               CASE WHEN $P{parType} = 1 THEN x.principal_overdue
                    WHEN $P{parType} = 2 THEN x.principal_overdue + x.interest_overdue
                    WHEN $P{parType} = 3 THEN x.principal_overdue + x.interest_overdue + x.fees_overdue
                    WHEN $P{parType} = 4 THEN x.principal_overdue + x.interest_overdue + x.fees_overdue + x.penalties_overdue
               END AS par_numerator,
               -- PAR type 4 divides by penalties OVERDUE (not outstanding), exactly as the stretchy report did
               CASE WHEN $P{parType} = 1 THEN x.principal_outstanding
                    WHEN $P{parType} = 2 THEN x.principal_outstanding + x.interest_outstanding
                    WHEN $P{parType} = 3 THEN x.principal_outstanding + x.interest_outstanding + x.fees_outstanding
                    WHEN $P{parType} = 4 THEN x.principal_outstanding + x.interest_outstanding + x.fees_outstanding + x.penalties_overdue
               END AS par_denominator
      FROM (SELECT o.name AS selected_office_name,
                   l.currency_code,
                   COALESCE(cur.display_symbol, l.currency_code) AS currency,
                   COALESCE(SUM(l.principal_outstanding_derived), 0) AS principal_outstanding,
                   COALESCE(SUM(laa.principal_overdue_derived), 0) AS principal_overdue,
                   COALESCE(SUM(l.interest_outstanding_derived), 0) AS interest_outstanding,
                   COALESCE(SUM(laa.interest_overdue_derived), 0) AS interest_overdue,
                   COALESCE(SUM(l.fee_charges_outstanding_derived), 0) AS fees_outstanding,
                   COALESCE(SUM(laa.fee_charges_overdue_derived), 0) AS fees_overdue,
                   COALESCE(SUM(l.penalty_charges_outstanding_derived), 0) AS penalties_outstanding,
                   COALESCE(SUM(laa.penalty_charges_overdue_derived), 0) AS penalties_overdue
            FROM m_office o
            JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
                                AND ounder.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
            JOIN m_client c ON c.office_id = ounder.id
            JOIN m_loan l ON l.client_id = c.id
            LEFT JOIN m_currency cur ON cur.code = l.currency_code
            LEFT JOIN m_loan_arrears_aging laa ON laa.loan_id = l.id
            WHERE o.id = $P{officeId}
              AND ($P{currencyId} = '-1' OR l.currency_code = $P{currencyId})
              AND ($P{loanProductId} = -1 OR l.product_id = $P{loanProductId})
              AND ($P{loanOfficerId} = -1 OR COALESCE(l.loan_officer_id, -10) = $P{loanOfficerId})
              AND ($P{fundId} = -1 OR COALESCE(l.fund_id, -10) = $P{fundId})
              AND ($P{loanPurposeId} = -1 OR COALESCE(l.loanpurpose_cv_id, -10) = $P{loanPurposeId})
              AND l.loan_status_id = 300
            GROUP BY o.name, l.currency_code, cur.display_symbol) x) y
ORDER BY y.currency_code
        ]]>
    </queryString>

    <field name="selected_office_name" class="java.lang.String"/>
    <field name="filter_loan_officer" class="java.lang.String"/>
    <field name="filter_product" class="java.lang.String"/>
    <field name="filter_fund" class="java.lang.String"/>
    <field name="filter_loan_purpose" class="java.lang.String"/>
    <field name="par_type_name" class="java.lang.String"/>
    <field name="currency_code" class="java.lang.String"/>
    <field name="currency" class="java.lang.String"/>
    <field name="principal_outstanding" class="java.math.BigDecimal"/>
    <field name="principal_overdue" class="java.math.BigDecimal"/>
    <field name="interest_outstanding" class="java.math.BigDecimal"/>
    <field name="interest_overdue" class="java.math.BigDecimal"/>
    <field name="fees_outstanding" class="java.math.BigDecimal"/>
    <field name="fees_overdue" class="java.math.BigDecimal"/>
    <field name="penalties_outstanding" class="java.math.BigDecimal"/>
    <field name="penalties_overdue" class="java.math.BigDecimal"/>
    <field name="par_numerator" class="java.math.BigDecimal"/>
    <field name="par_denominator" class="java.math.BigDecimal"/>
    <field name="par_percent" class="java.math.BigDecimal"/>

    <title>
        <band height="90">
            <staticText>
                <reportElement x="0" y="0" width="802" height="24"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Portfolio at Risk]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="0" y="26" width="70" height="18"/>
                <text><![CDATA[Office]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="70" y="26" width="330" height="18"/>
                <textFieldExpression><![CDATA[$F{selected_office_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="46" width="70" height="18"/>
                <text><![CDATA[PAR Type]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="70" y="46" width="330" height="18"/>
                <textFieldExpression><![CDATA[$F{par_type_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="420" y="26" width="80" height="18"/>
                <text><![CDATA[Currency]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="500" y="26" width="302" height="18"/>
                <textFieldExpression><![CDATA["-1".equals($P{currencyId}) ? "All" : $P{currencyId}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="420" y="46" width="80" height="18"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="500" y="46" width="302" height="18"/>
                <textFieldExpression><![CDATA[$P{loanOfficerId} == -1L ? "All" : $P{loanOfficerId} == -10L ? "(No loan officer)" : $F{filter_loan_officer}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="66" width="70" height="18"/>
                <text><![CDATA[Filters]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="70" y="66" width="732" height="18"/>
                <textFieldExpression><![CDATA["Product: " + ($P{loanProductId} == -1L ? "All" : $F{filter_product})
    + "     Fund: " + ($P{fundId} == -1L ? "All" : $P{fundId} == -10L ? "(No fund)" : $F{filter_fund})
    + "     Loan Purpose: " + ($P{loanPurposeId} == -1L ? "All" : $P{loanPurposeId} == -10L ? "(No purpose)" : $F{filter_loan_purpose})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="0" width="62" height="20"/>
                <text><![CDATA[Currency]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="62" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Principal Outstanding]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="142" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Principal Overdue]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="222" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Interest Outstanding]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="302" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Interest Overdue]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="382" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Fees Outstanding]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="462" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Fees Overdue]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="542" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Penalties Outstanding]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="622" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Penalties Overdue]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="702" y="0" width="100" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Portfolio at Risk %]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="62" height="18"/>
                <textFieldExpression><![CDATA[$F{currency}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="62" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{principal_outstanding}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="142" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{principal_overdue}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="222" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{interest_outstanding}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="302" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{interest_overdue}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="382" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{fees_outstanding}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="462" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{fees_overdue}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="542" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{penalties_outstanding}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="622" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{penalties_overdue}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="702" y="0" width="100" height="18"/>
                <textFieldExpression><![CDATA[$F{par_percent}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Label" x="0" y="2" width="300" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Printed by " + $P{currentUserName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd MMM yyyy HH:mm">
                <reportElement style="Label" x="300" y="2" width="200" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{currentDateTime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="602" y="2" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="772" y="2" width="30" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="802" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11"/></textElement>
                <text><![CDATA[No active loans for the selected office and filters.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
