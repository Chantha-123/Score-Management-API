<!-- Stretchy report "Trial Balance" (report_type = Jasper). Run with R_officeId (1 = head office, i.e. all offices),
     R_startDate, R_endDate (yyyy-MM-dd). SQL converted from "Trial Balance Table". -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="trial-balance" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.title" value="title"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="8"/>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>
    <style name="ColumnHeader" style="Base" isBold="true" mode="Opaque" backcolor="#E6E6E6" vTextAlign="Middle"/>
    <style name="Section" style="Base" isBold="true" mode="Opaque" backcolor="#F2F2F2" vTextAlign="Middle"/>
    <style name="Amount" style="Base" hTextAlign="Right" pattern="#,##0.00"/>
    <style name="Total" style="Amount" isBold="true"/>

    <!-- Supplied by the service on every run -->
    <parameter name="currentDate" class="java.util.Date"/>
    <parameter name="currentDateTime" class="java.util.Date"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>
    <!-- Stretchy parameter variables -->
    <parameter name="officeId" class="java.lang.Long">
        <!-- As in the stretchy SQL, office 1 (head office) means all offices; any other office means that office only -->
        <defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
    </parameter>
    <parameter name="startDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(new java.sql.Date($P{currentDate}.getTime()).toLocalDate().withDayOfMonth(1))]]></defaultValueExpression>
    </parameter>
    <parameter name="endDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[$P{currentDate}]]></defaultValueExpression>
    </parameter>

    <!-- Debit column: asset (1) and expense (5) accounts, debits - credits. Credit column: liability (2), equity (3)
         and income (4) accounts, credits - debits. journal entry type_enum: 1 = credit, 2 = debit. -->
    <queryString>
        <![CDATA[
SELECT (SELECT so.name FROM m_office so WHERE so.id = $P{officeId}) AS selected_office_name,
       tb.currency_code,
       tb.classification_enum,
       CASE tb.classification_enum WHEN 1 THEN 'Assets' WHEN 2 THEN 'Liabilities' WHEN 3 THEN 'Equity'
            WHEN 4 THEN 'Income' WHEN 5 THEN 'Expenses' ELSE 'Other' END AS account_type,
       tb.gl_code,
       tb.account_name,
       CASE WHEN tb.classification_enum IN (1, 5) THEN tb.debit_total - tb.credit_total END AS debit_balance,
       CASE WHEN tb.classification_enum IN (2, 3, 4) THEN tb.credit_total - tb.debit_total END AS credit_balance
FROM (SELECT je.currency_code,
             gl.classification_enum,
             gl.gl_code,
             gl.name AS account_name,
             SUM(CASE WHEN je.type_enum = 2 THEN COALESCE(je.amount, 0) ELSE 0 END) AS debit_total,
             SUM(CASE WHEN je.type_enum = 1 THEN COALESCE(je.amount, 0) ELSE 0 END) AS credit_total
      FROM acc_gl_journal_entry je
      JOIN acc_gl_account gl ON gl.id = je.account_id
      JOIN m_office jo ON jo.id = je.office_id
      WHERE je.type_enum IN (1, 2)
        AND je.entry_date BETWEEN $P{startDate} AND $P{endDate}
        AND ($P{officeId} = 1 OR je.office_id = $P{officeId})
        AND jo.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
      GROUP BY je.currency_code, gl.classification_enum, gl.gl_code, gl.name) tb
ORDER BY tb.currency_code, tb.classification_enum, tb.gl_code
        ]]>
    </queryString>

    <field name="selected_office_name" class="java.lang.String"/>
    <field name="currency_code" class="java.lang.String"/>
    <field name="classification_enum" class="java.lang.Integer"/>
    <field name="account_type" class="java.lang.String"/>
    <field name="gl_code" class="java.lang.String"/>
    <field name="account_name" class="java.lang.String"/>
    <field name="debit_balance" class="java.math.BigDecimal"/>
    <field name="credit_balance" class="java.math.BigDecimal"/>

    <variable name="typeDebit" class="java.math.BigDecimal" resetType="Group" resetGroup="accountType" calculation="Sum">
        <variableExpression><![CDATA[$F{debit_balance}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="typeCredit" class="java.math.BigDecimal" resetType="Group" resetGroup="accountType" calculation="Sum">
        <variableExpression><![CDATA[$F{credit_balance}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="currencyDebit" class="java.math.BigDecimal" resetType="Group" resetGroup="currency" calculation="Sum">
        <!-- null-safe: a Sum stays null when every row of the currency is a credit-type account, and the difference below would throw -->
        <variableExpression><![CDATA[$F{debit_balance} == null ? java.math.BigDecimal.ZERO : $F{debit_balance}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="currencyCredit" class="java.math.BigDecimal" resetType="Group" resetGroup="currency" calculation="Sum">
        <variableExpression><![CDATA[$F{credit_balance} == null ? java.math.BigDecimal.ZERO : $F{credit_balance}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <!-- Amounts in different currencies are never added together: each currency is its own trial balance -->
    <group name="currency" isReprintHeaderOnEachPage="true">
        <groupExpression><![CDATA[$F{currency_code}]]></groupExpression>
        <groupHeader>
            <band height="22">
                <textField>
                    <reportElement style="Value" x="0" y="2" width="555" height="18"/>
                    <textElement><font size="9"/></textElement>
                    <textFieldExpression><![CDATA["Currency: " + $F{currency_code}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="48">
                <line>
                    <reportElement x="395" y="2" width="160" height="1"/>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="4" width="395" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total (" + $F{currency_code} + ")"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="395" y="4" width="80" height="18"/>
                    <textFieldExpression><![CDATA[$V{currencyDebit}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="475" y="4" width="80" height="18"/>
                    <textFieldExpression><![CDATA[$V{currencyCredit}]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="395" y="23" width="160" height="1"/>
                    <graphicElement><pen lineWidth="1.5" lineStyle="Double"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Label" x="0" y="26" width="395" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Difference (debit - credit)"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="395" y="26" width="80" height="18"/>
                    <textFieldExpression><![CDATA[$V{currencyDebit}.subtract($V{currencyCredit})]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>
    <group name="accountType">
        <groupExpression><![CDATA[$F{currency_code} + "|" + $F{classification_enum}]]></groupExpression>
        <groupHeader>
            <band height="18">
                <textField>
                    <reportElement style="Section" x="0" y="0" width="555" height="18"/>
                    <textFieldExpression><![CDATA[$F{account_type}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="22">
                <line>
                    <reportElement x="395" y="1" width="160" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="2" width="395" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total " + $F{account_type}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="395" y="2" width="80" height="18"/>
                    <textFieldExpression><![CDATA[$V{typeDebit}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="475" y="2" width="80" height="18"/>
                    <textFieldExpression><![CDATA[$V{typeCredit}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="555" height="24"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Trial Balance]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="0" y="26" width="60" height="18"/>
                <text><![CDATA[Office]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="60" y="26" width="495" height="18"/>
                <textFieldExpression><![CDATA[$F{selected_office_name} + (Long.valueOf(1L).equals($P{officeId}) ? " (all offices)" : "")]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="46" width="60" height="18"/>
                <text><![CDATA[Period]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="60" y="46" width="495" height="18"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{startDate}) + " - " + new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{endDate})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="0" width="80" height="20"/>
                <text><![CDATA[GL Code]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="80" y="0" width="315" height="20"/>
                <text><![CDATA[Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="395" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Debit]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="475" y="0" width="80" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Credit]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{gl_code}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="80" y="0" width="315" height="18"/>
                <textFieldExpression><![CDATA[$F{account_name}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Amount" x="395" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{debit_balance}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement style="Amount" x="475" y="0" width="80" height="18"/>
                <textFieldExpression><![CDATA[$F{credit_balance}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Label" x="0" y="2" width="200" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Printed by " + $P{currentUserName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd MMM yyyy HH:mm">
                <reportElement style="Label" x="200" y="2" width="155" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{currentDateTime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="355" y="2" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="525" y="2" width="30" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="555" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11"/></textElement>
                <text><![CDATA[No journal entries for the selected office and period.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
