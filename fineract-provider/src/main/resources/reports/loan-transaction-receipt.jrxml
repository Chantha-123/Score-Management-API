<!-- Stretchy report "Loan Transaction Receipt" (report_type = Jasper). Run with R_transactionId=<m_loan_transaction.id>. -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="loan-transaction-receipt" pageWidth="420" pageHeight="595" columnWidth="364"
              leftMargin="28" rightMargin="28" topMargin="28" bottomMargin="28" whenNoDataType="NoDataSection">

    <!-- Client, office and payment type names may be Khmer: lay out Khmer runs with Java's text engine (OpenPDF cannot shape them) -->
    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>

    <!-- Font set from fonts/battambang/fonts.xml: DejaVu Sans, with Battambang for Khmer characters.
         Battambang lines need about 2x the font size in height, so rows are 18pt tall. -->
    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="9"/>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>

    <parameter name="transactionId" class="java.lang.Long"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>

    <queryString>
        <![CDATA[
SELECT tr.id AS transaction_id,
       tr.transaction_date,
       tr.amount,
       COALESCE(tr.principal_portion_derived, 0) AS principal_portion,
       COALESCE(tr.interest_portion_derived, 0) AS interest_portion,
       COALESCE(tr.fee_charges_portion_derived, 0) AS fee_portion,
       COALESCE(tr.penalty_charges_portion_derived, 0) AS penalty_portion,
       COALESCE(tr.outstanding_loan_balance_derived, 0) AS outstanding_balance,
       CASE tr.transaction_type_enum
           WHEN 1 THEN 'Disbursement'
           WHEN 2 THEN 'Repayment'
           WHEN 5 THEN 'Repayment at Disbursement'
           WHEN 8 THEN 'Recovery Repayment'
           WHEN 17 THEN 'Charge Payment'
           WHEN 24 THEN 'Principal Paydown'
           ELSE 'Loan Transaction'
       END AS transaction_type,
       l.account_no AS loan_account_no,
       l.currency_code,
       l.currency_digits,
       COALESCE(c.display_name, g.display_name) AS client_name,
       c.account_no AS client_account_no,
       o.name AS office_name,
       pd.receipt_number,
       pt.value AS payment_type
FROM m_loan_transaction tr
JOIN m_loan l ON l.id = tr.loan_id
JOIN m_office o ON o.id = tr.office_id
LEFT JOIN m_client c ON c.id = l.client_id
LEFT JOIN m_group g ON g.id = l.group_id
LEFT JOIN m_payment_detail pd ON pd.id = tr.payment_detail_id
LEFT JOIN m_payment_type pt ON pt.id = pd.payment_type_id
WHERE tr.id = $P{transactionId}
  AND o.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
        ]]>
    </queryString>

    <field name="transaction_id" class="java.lang.Long"/>
    <field name="transaction_date" class="java.util.Date"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="principal_portion" class="java.math.BigDecimal"/>
    <field name="interest_portion" class="java.math.BigDecimal"/>
    <field name="fee_portion" class="java.math.BigDecimal"/>
    <field name="penalty_portion" class="java.math.BigDecimal"/>
    <field name="outstanding_balance" class="java.math.BigDecimal"/>
    <field name="transaction_type" class="java.lang.String"/>
    <field name="loan_account_no" class="java.lang.String"/>
    <field name="currency_code" class="java.lang.String"/>
    <field name="currency_digits" class="java.lang.Integer"/>
    <field name="client_name" class="java.lang.String"/>
    <field name="client_account_no" class="java.lang.String"/>
    <field name="office_name" class="java.lang.String"/>
    <field name="receipt_number" class="java.lang.String"/>
    <field name="payment_type" class="java.lang.String"/>

    <variable name="amountPattern" class="java.lang.String">
        <variableExpression><![CDATA[$F{currency_digits} == null || $F{currency_digits}.intValue() > 0 ? "#,##0.00" : "#,##0"]]></variableExpression>
    </variable>

    <detail>
        <band height="470">
            <!-- Header -->
            <textField>
                <reportElement x="0" y="0" width="364" height="28"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{office_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="28" width="364" height="30"/>
                <textElement textAlignment="Center"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[PAYMENT RECEIPT]]></text>
            </staticText>
            <line>
                <reportElement x="0" y="60" width="364" height="1"/>
            </line>

            <!-- Receipt identification -->
            <staticText>
                <reportElement style="Label" x="0" y="64" width="130" height="18"/>
                <text><![CDATA[Receipt No.]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="130" y="64" width="234" height="18"/>
                <textFieldExpression><![CDATA[$F{receipt_number} != null ? $F{receipt_number} : String.valueOf($F{transaction_id})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="84" width="130" height="18"/>
                <text><![CDATA[Transaction Date]]></text>
            </staticText>
            <textField pattern="dd MMMM yyyy">
                <reportElement style="Value" x="130" y="84" width="234" height="18"/>
                <textFieldExpression><![CDATA[$F{transaction_date}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="104" width="130" height="18"/>
                <text><![CDATA[Transaction Type]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="130" y="104" width="234" height="18"/>
                <textFieldExpression><![CDATA[$F{transaction_type}]]></textFieldExpression>
            </textField>

            <!-- Client and account -->
            <staticText>
                <reportElement style="Label" x="0" y="132" width="130" height="18"/>
                <text><![CDATA[Client Name]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="130" y="132" width="234" height="18"/>
                <textFieldExpression><![CDATA[$F{client_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="152" width="130" height="18"/>
                <text><![CDATA[Client No.]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="130" y="152" width="234" height="18"/>
                <textFieldExpression><![CDATA[$F{client_account_no} != null ? $F{client_account_no} : "-"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="172" width="130" height="18"/>
                <text><![CDATA[Loan Account]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="130" y="172" width="234" height="18"/>
                <textFieldExpression><![CDATA[$F{loan_account_no}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="192" width="130" height="18"/>
                <text><![CDATA[Payment Method]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="130" y="192" width="234" height="18"/>
                <textFieldExpression><![CDATA[$F{payment_type} != null ? $F{payment_type} : "-"]]></textFieldExpression>
            </textField>

            <!-- Amount -->
            <rectangle>
                <reportElement x="0" y="220" width="364" height="38" backcolor="#F2F2F2"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="220" width="150" height="38"/>
                <textElement verticalAlignment="Middle"><font size="11" isBold="true"/></textElement>
                <text><![CDATA[Amount Paid]]></text>
            </staticText>
            <textField>
                <reportElement x="160" y="220" width="194" height="38"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{currency_code} + " " + new java.text.DecimalFormat($V{amountPattern}).format($F{amount})]]></textFieldExpression>
            </textField>

            <!-- Allocation breakdown -->
            <staticText>
                <reportElement style="Label" x="0" y="270" width="200" height="18"/>
                <text><![CDATA[Principal]]></text>
            </staticText>
            <textField>
                <reportElement style="Base" x="200" y="270" width="164" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{principal_portion}]]></textFieldExpression>
                <patternExpression><![CDATA[$V{amountPattern}]]></patternExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="290" width="200" height="18"/>
                <text><![CDATA[Interest]]></text>
            </staticText>
            <textField>
                <reportElement style="Base" x="200" y="290" width="164" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{interest_portion}]]></textFieldExpression>
                <patternExpression><![CDATA[$V{amountPattern}]]></patternExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="310" width="200" height="18"/>
                <text><![CDATA[Fees]]></text>
            </staticText>
            <textField>
                <reportElement style="Base" x="200" y="310" width="164" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{fee_portion}]]></textFieldExpression>
                <patternExpression><![CDATA[$V{amountPattern}]]></patternExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="330" width="200" height="18"/>
                <text><![CDATA[Penalties]]></text>
            </staticText>
            <textField>
                <reportElement style="Base" x="200" y="330" width="164" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{penalty_portion}]]></textFieldExpression>
                <patternExpression><![CDATA[$V{amountPattern}]]></patternExpression>
            </textField>
            <line>
                <reportElement x="0" y="352" width="364" height="1"/>
                <graphicElement><pen lineWidth="0.5" lineStyle="Dashed"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="Label" x="0" y="358" width="200" height="18"/>
                <text><![CDATA[Outstanding Loan Balance]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="200" y="358" width="164" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$F{outstanding_balance}]]></textFieldExpression>
                <patternExpression><![CDATA[$V{amountPattern}]]></patternExpression>
            </textField>

            <!-- Signatures -->
            <line>
                <reportElement x="0" y="430" width="150" height="1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="Label" x="0" y="434" width="150" height="18"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Client Signature]]></text>
            </staticText>
            <line>
                <reportElement x="214" y="430" width="150" height="1"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <staticText>
                <reportElement style="Label" x="214" y="434" width="150" height="18"/>
                <textElement textAlignment="Center"/>
                <text><![CDATA[Cashier Signature]]></text>
            </staticText>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Label" x="0" y="2" width="200" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Printed by " + $P{currentUserName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd MMM yyyy HH:mm">
                <reportElement style="Label" x="200" y="2" width="164" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="364" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11"/></textElement>
                <text><![CDATA[Transaction not found, or not in your office hierarchy.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
