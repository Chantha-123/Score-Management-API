<!-- Stretchy report "Expected Payments By Date - Basic(Pentaho)" (report_type = Jasper), converted from the SQL of the Table report "Expected Payments By Date - Basic".
     Run with R_officeId, R_loanOfficerId (-1 = All, -10 = no officer), R_startDate, R_endDate (yyyy-MM-dd). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="expected-payments-by-date-basic-pentaho" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

    <!-- Names may be Khmer: lay out Khmer runs with Java's text engine (OpenPDF cannot shape them) -->
    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>
    <!-- CSV/XLSX: keep only column headers, detail rows and totals (no repeated titles / page footers) -->
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.title" value="title"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>

    <!-- Font set from fonts/battambang/fonts.xml: DejaVu Sans, with Battambang for Khmer characters.
         Battambang lines need about 2x the font size in height, so 8pt rows are 18pt tall. -->
    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="8" isBlankWhenNull="true">
        <box leftPadding="2" rightPadding="2"/>
    </style>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>
    <style name="ColumnHeader" style="Base" isBold="true" mode="Opaque" backcolor="#E6E6E6" vTextAlign="Middle"/>
    <style name="Amount" style="Base" hTextAlign="Right" pattern="#,##0.00"/>
    <style name="Total" style="Amount" isBold="true"/>
    <style name="Count" style="Base" hTextAlign="Right" pattern="#,##0"/>
    <style name="TotalCount" style="Count" isBold="true"/>

    <!-- Supplied by the service on every run -->
    <parameter name="currentDate" class="java.util.Date"/>
    <parameter name="currentDateTime" class="java.util.Date"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>
    <!-- Stretchy parameter variables; defaults apply when the R_ value is missing or blank -->
    <parameter name="officeId" class="java.lang.Long">
        <!-- OfficeIdSelectOne has no "All": default to the head office (root of the hierarchy) -->
        <defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanOfficerId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="startDate" class="java.util.Date">
        <!-- First day of the business month -->
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(new java.sql.Date($P{currentDate}.getTime()).toLocalDate().withDayOfMonth(1))]]></defaultValueExpression>
    </parameter>
    <parameter name="endDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[$P{currentDate}]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
SELECT (SELECT so.name FROM m_office so WHERE so.id = $P{officeId}) AS selected_office_name,
       (SELECT ss.display_name FROM m_staff ss WHERE ss.id = $P{loanOfficerId}) AS selected_loan_officer,
       ounder.id AS office_id,
       ounder.name AS office_name,
       ml.currency_code,
       COALESCE(cu.display_symbol, ml.currency_code) AS currency,
       COALESCE(ms.display_name, '-') AS loan_officer_name,
       mc.account_no AS client_account_no,
       mc.display_name AS client_name,
       mp.name AS product_name,
       ml.account_no AS loan_account_no,
       mr.duedate AS due_date,
       mr.installment,
       mr.principal_amount - COALESCE(mr.principal_completed_derived, 0) AS principal_due,
       mr.interest_amount - COALESCE(mr.interest_completed_derived, mr.interest_waived_derived, 0) AS interest_due,
       COALESCE(mr.fee_charges_amount, 0) - COALESCE(mr.fee_charges_completed_derived, mr.fee_charges_waived_derived, 0) AS fees_due,
       COALESCE(mr.penalty_charges_amount, 0) - COALESCE(mr.penalty_charges_completed_derived, mr.penalty_charges_waived_derived, 0) AS penalty_due,
       (mr.principal_amount - COALESCE(mr.principal_completed_derived, 0))
         + (mr.interest_amount - COALESCE(mr.interest_completed_derived, mr.interest_waived_derived, 0))
         + (COALESCE(mr.fee_charges_amount, 0) - COALESCE(mr.fee_charges_completed_derived, mr.fee_charges_waived_derived, 0))
         + (COALESCE(mr.penalty_charges_amount, 0) - COALESCE(mr.penalty_charges_completed_derived, mr.penalty_charges_waived_derived, 0)) AS total_due,
       mlaa.total_overdue_derived AS total_overdue
FROM m_office mo
JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(mo.hierarchy, '%')
                    AND ounder.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
LEFT JOIN m_client mc ON mc.office_id = ounder.id
LEFT JOIN m_loan ml ON ml.client_id = mc.id AND ml.loan_status_id = 300
LEFT JOIN m_loan_arrears_aging mlaa ON mlaa.loan_id = ml.id
LEFT JOIN m_loan_repayment_schedule mr ON mr.loan_id = ml.id AND mr.completed_derived = FALSE
LEFT JOIN m_product_loan mp ON mp.id = ml.product_id
LEFT JOIN m_staff ms ON ms.id = ml.loan_officer_id
LEFT JOIN m_currency cu ON cu.code = ml.currency_code
WHERE mo.id = $P{officeId}
  AND ($P{loanOfficerId} = -1 OR COALESCE(ml.loan_officer_id, -10) = $P{loanOfficerId})
  AND mr.duedate BETWEEN $P{startDate} AND $P{endDate}
ORDER BY ounder.id, ml.currency_code, mr.duedate, ml.account_no
        ]]>
    </queryString>

    <!-- Field names = SQL aliases, lowercase snake_case (PostgreSQL folds unquoted aliases to lowercase) -->
    <field name="selected_office_name" class="java.lang.String"/>
    <field name="selected_loan_officer" class="java.lang.String"/>
    <field name="office_id" class="java.lang.Long"/>
    <field name="office_name" class="java.lang.String"/>
    <field name="currency_code" class="java.lang.String"/>
    <field name="currency" class="java.lang.String"/>
    <field name="loan_officer_name" class="java.lang.String"/>
    <field name="client_account_no" class="java.lang.String"/>
    <field name="client_name" class="java.lang.String"/>
    <field name="product_name" class="java.lang.String"/>
    <field name="loan_account_no" class="java.lang.String"/>
    <field name="due_date" class="java.util.Date"/>
    <field name="installment" class="java.lang.Integer"/>
    <field name="principal_due" class="java.math.BigDecimal"/>
    <field name="interest_due" class="java.math.BigDecimal"/>
    <field name="fees_due" class="java.math.BigDecimal"/>
    <field name="penalty_due" class="java.math.BigDecimal"/>
    <field name="total_due" class="java.math.BigDecimal"/>
    <field name="total_overdue" class="java.math.BigDecimal"/>

    <variable name="groupPrincipalDue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_due}]]></variableExpression>
    </variable>
    <variable name="groupInterestDue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_due}]]></variableExpression>
    </variable>
    <variable name="groupFeesDue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_due}]]></variableExpression>
    </variable>
    <variable name="groupPenaltyDue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{penalty_due}]]></variableExpression>
    </variable>
    <variable name="groupTotalDue" class="java.math.BigDecimal" resetType="Group" resetGroup="officeCurrency" calculation="Sum">
        <variableExpression><![CDATA[$F{total_due}]]></variableExpression>
    </variable>

    <group name="officeCurrency">
        <groupExpression><![CDATA[$F{office_id} + "|" + $F{currency_code}]]></groupExpression>
        <groupHeader>
            <band height="22">
                <textField>
                    <reportElement style="Value" x="0" y="2" width="802" height="18"/>
                    <textFieldExpression><![CDATA[$F{office_name} + "  (" + $F{currency} + ")"]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
        <band height="22">
                <line>
                    <reportElement x="0" y="1" width="802" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="2" width="465" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Subtotal " + $F{office_name} + " (" + $F{currency} + "), " + $V{officeCurrency_COUNT} + " installments"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="465" y="2" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupPrincipalDue}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="521" y="2" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupInterestDue}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="577" y="2" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupFeesDue}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="633" y="2" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupPenaltyDue}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" positionType="Float" x="689" y="2" width="57" height="18"/>
                    <textFieldExpression><![CDATA[$V{groupTotalDue}]]></textFieldExpression>
                </textField>
        </band>
        </groupFooter>
    </group>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="802" height="24"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Expected Payments By Date - Basic]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="0" y="26" width="80" height="18"/>
                <text><![CDATA[Office]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="26" width="311" height="18"/>
                <textFieldExpression><![CDATA[$F{selected_office_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="401" y="26" width="80" height="18"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="481" y="26" width="311" height="18"/>
                <textFieldExpression><![CDATA[$P{loanOfficerId} == -1L ? "All" : ($P{loanOfficerId} == -10L ? "None" : $F{selected_loan_officer})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="46" width="80" height="18"/>
                <text><![CDATA[Period]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="80" y="46" width="311" height="18"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{startDate}) + " - " + new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{endDate})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="24">
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="0" width="80" height="24"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="80" y="0" width="60" height="24"/>
                <text><![CDATA[Client Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="140" y="0" width="110" height="24"/>
                <text><![CDATA[Name]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="250" y="0" width="75" height="24"/>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="325" y="0" width="60" height="24"/>
                <text><![CDATA[Loan Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="385" y="0" width="52" height="24"/>
                <text><![CDATA[Due Date]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="437" y="0" width="28" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Inst.]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="465" y="0" width="56" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Principal Due]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="521" y="0" width="56" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Interest Due]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="577" y="0" width="56" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Fees Due]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="633" y="0" width="56" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Penalty Due]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="689" y="0" width="57" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Total Due]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="746" y="0" width="56" height="24"/>
                    <textElement textAlignment="Right"/>
                <text><![CDATA[Total Overdue]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
                <textField textAdjust="StretchHeight">
                    <reportElement x="0" y="0" width="80" height="18"/>
                    <textFieldExpression><![CDATA[$F{loan_officer_name}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="80" y="0" width="60" height="18"/>
                    <textFieldExpression><![CDATA[$F{client_account_no}]]></textFieldExpression>
                </textField>
                <textField textAdjust="StretchHeight">
                    <reportElement x="140" y="0" width="110" height="18"/>
                    <textFieldExpression><![CDATA[$F{client_name}]]></textFieldExpression>
                </textField>
                <textField textAdjust="StretchHeight">
                    <reportElement x="250" y="0" width="75" height="18"/>
                    <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="325" y="0" width="60" height="18"/>
                    <textFieldExpression><![CDATA[$F{loan_account_no}]]></textFieldExpression>
                </textField>
                <textField pattern="dd/MM/yyyy">
                    <reportElement x="385" y="0" width="52" height="18"/>
                    <textFieldExpression><![CDATA[$F{due_date}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Count" x="437" y="0" width="28" height="18"/>
                    <textFieldExpression><![CDATA[$F{installment}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="465" y="0" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$F{principal_due}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="521" y="0" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$F{interest_due}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="577" y="0" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$F{fees_due}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="633" y="0" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$F{penalty_due}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="689" y="0" width="57" height="18"/>
                    <textFieldExpression><![CDATA[$F{total_due}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Amount" x="746" y="0" width="56" height="18"/>
                    <textFieldExpression><![CDATA[$F{total_overdue}]]></textFieldExpression>
                </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Label" x="0" y="2" width="300" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Printed by " + $P{currentUserName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd MMM yyyy HH:mm">
                <reportElement style="Label" x="301" y="2" width="200" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{currentDateTime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="602" y="2" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="772" y="2" width="30" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="24">
            <line>
                <reportElement x="0" y="2" width="802" height="1"/>
            </line>
            <textField>
                <reportElement style="Value" x="0" y="4" width="802" height="18"/>
                <textFieldExpression><![CDATA["Total, " + $V{REPORT_COUNT} + " installments"]]></textFieldExpression>
            </textField>
        </band>
    </summary>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="802" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11"/></textElement>
                <text><![CDATA[No unpaid installments due in the selected period for the selected office and loan officer.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
