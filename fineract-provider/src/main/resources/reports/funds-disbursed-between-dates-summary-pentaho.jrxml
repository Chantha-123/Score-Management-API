<!-- Stretchy report "Funds Disbursed Between Dates Summary(Pentaho)" (report_type = Jasper).
     Run with R_currencyId (-1 = All), R_fundId (-1 = All, -10 = no fund), R_startDate, R_endDate (yyyy-MM-dd). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="funds-disbursed-between-dates-summary-pentaho" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.title" value="title"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="8"/>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>
    <style name="ColumnHeader" style="Base" isBold="true" mode="Opaque" backcolor="#E6E6E6" vTextAlign="Middle"/>
    <style name="Amount" style="Base" hTextAlign="Right" pattern="#,##0.00"/>
    <style name="Total" style="Amount" isBold="true"/>

    <parameter name="currentDate" class="java.util.Date"/>
    <parameter name="currentDateTime" class="java.util.Date"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>
    <parameter name="currencyId" class="java.lang.String">
        <defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
    </parameter>
    <parameter name="fundId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="startDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[$P{currentDate}]]></defaultValueExpression>
    </parameter>
    <parameter name="endDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[$P{currentDate}]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
SELECT (SELECT fu.name FROM m_fund fu WHERE fu.id = $P{fundId}) AS filter_fund,
       COALESCE(f.name, '-') AS fund_name,
       l.currency_code,
       COALESCE(cur.display_symbol, l.currency_code) AS currency,
       ROUND(SUM(l.principal_amount), 4) AS disbursed_amount
FROM m_office ounder
JOIN m_client c ON c.office_id = ounder.id
JOIN m_loan l ON l.client_id = c.id
JOIN m_currency cur ON cur.code = l.currency_code
LEFT JOIN m_fund f ON f.id = l.fund_id
WHERE l.disbursedon_date BETWEEN $P{startDate} AND $P{endDate}
  AND ($P{fundId} = -1 OR COALESCE(l.fund_id, -10) = $P{fundId})
  AND ($P{currencyId} = '-1' OR l.currency_code = $P{currencyId})
  AND ounder.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
GROUP BY l.currency_code, cur.display_symbol, COALESCE(f.name, '-')
ORDER BY l.currency_code, COALESCE(f.name, '-')
        ]]>
    </queryString>

    <field name="filter_fund" class="java.lang.String"/>
    <field name="fund_name" class="java.lang.String"/>
    <field name="currency_code" class="java.lang.String"/>
    <field name="currency" class="java.lang.String"/>
    <field name="disbursed_amount" class="java.math.BigDecimal"/>

    <variable name="currencyDisbursed" class="java.math.BigDecimal" resetType="Group" resetGroup="currency" calculation="Sum">
        <variableExpression><![CDATA[$F{disbursed_amount}]]></variableExpression>
    </variable>

    <!-- Amounts in different currencies are never added together: one subtotal per currency -->
    <group name="currency">
        <groupExpression><![CDATA[$F{currency_code}]]></groupExpression>
        <groupFooter>
            <band height="22">
                <line>
                    <reportElement x="405" y="1" width="150" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="2" width="405" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total " + $F{currency}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="405" y="2" width="150" height="18"/>
                    <textFieldExpression><![CDATA[$V{currencyDisbursed}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="555" height="24"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Funds Disbursed Between Dates Summary]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="0" y="26" width="60" height="18"/>
                <text><![CDATA[Period]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="60" y="26" width="220" height="18"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{startDate}) + " - " + new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{endDate})]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="290" y="26" width="60" height="18"/>
                <text><![CDATA[Currency]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="350" y="26" width="205" height="18"/>
                <textFieldExpression><![CDATA["-1".equals($P{currencyId}) ? "All" : $P{currencyId}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="290" y="46" width="60" height="18"/>
                <text><![CDATA[Fund]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="350" y="46" width="205" height="18"/>
                <textFieldExpression><![CDATA[$P{fundId} == -1L ? "All" : $P{fundId} == -10L ? "(No fund)" : $F{filter_fund}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="0" width="300" height="20"/>
                <text><![CDATA[Fund]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="300" y="0" width="105" height="20"/>
                <text><![CDATA[Currency]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="405" y="0" width="150" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Disbursed Amount]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="0" width="300" height="18"/>
                <textFieldExpression><![CDATA[$F{fund_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="300" y="0" width="105" height="18"/>
                <textFieldExpression><![CDATA[$F{currency}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="405" y="0" width="150" height="18"/>
                <textFieldExpression><![CDATA[$F{disbursed_amount}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Label" x="0" y="2" width="200" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Printed by " + $P{currentUserName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd MMM yyyy HH:mm">
                <reportElement style="Label" x="200" y="2" width="155" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{currentDateTime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="355" y="2" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="525" y="2" width="30" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="555" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11"/></textElement>
                <text><![CDATA[No funds disbursed in the selected period for the selected fund and currency.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
