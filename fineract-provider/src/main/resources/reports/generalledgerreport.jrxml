<!-- Stretchy report "GeneralLedgerReport" (report_type = Jasper). Run with R_GLAccountNO (acc_gl_account.id),
     R_officeId (the office and the offices below it), R_startDate, R_endDate (yyyy-MM-dd).
     SQL converted from "GeneralLedgerReport Table". -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="generalledgerreport" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.title" value="title"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>

    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="8"/>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>
    <style name="ColumnHeader" style="Base" isBold="true" mode="Opaque" backcolor="#E6E6E6" vTextAlign="Middle"/>
    <style name="Section" style="Base" isBold="true" mode="Opaque" backcolor="#F2F2F2" vTextAlign="Middle"/>
    <style name="Amount" style="Base" hTextAlign="Right" pattern="#,##0.00"/>
    <style name="Total" style="Amount" isBold="true"/>

    <!-- Supplied by the service on every run -->
    <parameter name="currentDate" class="java.util.Date"/>
    <parameter name="currentDateTime" class="java.util.Date"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>
    <!-- Stretchy parameter variables -->
    <parameter name="GLAccountNO" class="java.lang.Long"/>
    <parameter name="officeId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
    </parameter>
    <parameter name="startDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(new java.sql.Date($P{currentDate}.getTime()).toLocalDate().withDayOfMonth(1))]]></defaultValueExpression>
    </parameter>
    <parameter name="endDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[$P{currentDate}]]></defaultValueExpression>
    </parameter>
    <!-- Derived, not a stretchy parameter: the stretchy SQL took the opening balance from entries dated on or before
         DATE_SUB(startDate, INTERVAL 2 DAY). Date arithmetic is not portable, so the cut-off is computed here. -->
    <parameter name="openingBalanceDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[java.sql.Date.valueOf(new java.sql.Date($P{startDate}.getTime()).toLocalDate().minusDays(2))]]></defaultValueExpression>
    </parameter>

    <!-- One row per date / contra account / description (system entries) or per manual journal entry, for the
         journal entries on the other side of each transaction that touched the selected account in the office
         hierarchy and period. debit_amount / credit_amount are from the selected account's point of view (a credit
         on the contra account, type_enum 1, is a debit to the selected account). movement is debit - credit for
         asset (1) / expense (5) accounts and credit - debit otherwise; the running balance is computed in the
         report. -->
    <queryString>
        <![CDATA[
SELECT (SELECT so.name FROM m_office so WHERE so.id = $P{officeId}) AS selected_office_name,
       details.report_header,
       details.entry_date,
       details.description,
       details.account_name,
       details.manual_entry_id,
       MIN(details.id) AS first_entry_id,
       SUM(details.debit_amount) AS debit_amount,
       SUM(details.credit_amount) AS credit_amount,
       COALESCE(opb.opening_balance, 0) AS opening_balance,
       CASE WHEN details.actype IN (1, 5) THEN SUM(details.debit_amount) - SUM(details.credit_amount)
            ELSE SUM(details.credit_amount) - SUM(details.debit_amount) END AS movement
FROM (SELECT a.account_id AS acid1,
             CONCAT(gl.gl_code, '-', gl.name) AS report_header,
             gl.classification_enum AS actype,
             j1.entry_date,
             CONCAT(gl1.gl_code, '-', gl1.name) AS account_name,
             CASE WHEN j1.type_enum = 1 THEN j1.amount ELSE 0 END AS debit_amount,
             CASE WHEN j1.type_enum = 2 THEN j1.amount ELSE 0 END AS credit_amount,
             j1.id,
             j1.description,
             CASE WHEN a.manual_entry = TRUE THEN j1.id END AS manual_entry_id
      FROM acc_gl_journal_entry j1
      JOIN (SELECT DISTINCT je.transaction_id AS tid, je.account_id, je.manual_entry
            FROM m_office o
            JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
                                AND ounder.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
            JOIN acc_gl_journal_entry je ON je.office_id = ounder.id
            WHERE je.account_id = $P{GLAccountNO}
              AND o.id = $P{officeId}
              AND je.entry_date BETWEEN $P{startDate} AND $P{endDate}) a
        ON a.tid = j1.transaction_id AND j1.account_id <> $P{GLAccountNO}
      LEFT JOIN acc_gl_account gl ON gl.id = a.account_id
      LEFT JOIN acc_gl_account gl1 ON gl1.id = j1.account_id) details
LEFT JOIN (SELECT je.account_id AS acid2,
                  CASE WHEN aga1.classification_enum IN (1, 5)
                       THEN SUM(CASE WHEN je.type_enum = 2 THEN COALESCE(je.amount, 0) ELSE 0 END)
                            - SUM(CASE WHEN je.type_enum = 1 THEN COALESCE(je.amount, 0) ELSE 0 END)
                       ELSE SUM(CASE WHEN je.type_enum = 1 THEN COALESCE(je.amount, 0) ELSE 0 END)
                            - SUM(CASE WHEN je.type_enum = 2 THEN COALESCE(je.amount, 0) ELSE 0 END) END AS opening_balance
           FROM m_office o
           JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
                               AND ounder.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
           JOIN acc_gl_journal_entry je ON je.office_id = ounder.id
           JOIN acc_gl_account aga1 ON aga1.id = je.account_id
           WHERE je.entry_date <= $P{openingBalanceDate}
             AND je.office_running_balance IS NOT NULL
             AND o.id = $P{officeId}
             AND je.account_id = $P{GLAccountNO}
           GROUP BY je.account_id, aga1.classification_enum) opb ON opb.acid2 = details.acid1
GROUP BY details.report_header, details.actype, details.entry_date, details.manual_entry_id, details.description,
         details.account_name, opb.opening_balance
ORDER BY details.report_header, details.entry_date, first_entry_id
        ]]>
    </queryString>

    <field name="selected_office_name" class="java.lang.String"/>
    <field name="report_header" class="java.lang.String"/>
    <field name="entry_date" class="java.util.Date"/>
    <field name="description" class="java.lang.String"/>
    <field name="account_name" class="java.lang.String"/>
    <field name="manual_entry_id" class="java.lang.Long"/>
    <field name="first_entry_id" class="java.lang.Long"/>
    <field name="debit_amount" class="java.math.BigDecimal"/>
    <field name="credit_amount" class="java.math.BigDecimal"/>
    <field name="opening_balance" class="java.math.BigDecimal"/>
    <field name="movement" class="java.math.BigDecimal"/>

    <variable name="accountDebit" class="java.math.BigDecimal" resetType="Group" resetGroup="account" calculation="Sum">
        <variableExpression><![CDATA[$F{debit_amount}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="accountCredit" class="java.math.BigDecimal" resetType="Group" resetGroup="account" calculation="Sum">
        <variableExpression><![CDATA[$F{credit_amount}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>
    <variable name="accountMovement" class="java.math.BigDecimal" resetType="Group" resetGroup="account" calculation="Sum">
        <variableExpression><![CDATA[$F{movement}]]></variableExpression>
        <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
    </variable>

    <group name="account">
        <groupExpression><![CDATA[$F{report_header}]]></groupExpression>
        <groupHeader>
            <band height="40">
                <textField>
                    <reportElement style="Section" x="0" y="2" width="555" height="18"/>
                    <textElement><font size="9"/></textElement>
                    <textFieldExpression><![CDATA["Account: " + $F{report_header}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Value" x="0" y="20" width="480" height="18"/>
                    <textFieldExpression><![CDATA["Opening balance"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="480" y="20" width="75" height="18"/>
                    <textFieldExpression><![CDATA[$F{opening_balance}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="44">
                <line>
                    <reportElement x="330" y="1" width="225" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="2" width="330" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Total for the period"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="330" y="2" width="75" height="18"/>
                    <textFieldExpression><![CDATA[$V{accountDebit}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="405" y="2" width="75" height="18"/>
                    <textFieldExpression><![CDATA[$V{accountCredit}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Value" x="0" y="22" width="480" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Closing balance"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="480" y="22" width="75" height="18"/>
                    <textFieldExpression><![CDATA[$F{opening_balance}.add($V{accountMovement})]]></textFieldExpression>
                </textField>
                <line>
                    <reportElement x="480" y="41" width="75" height="1"/>
                    <graphicElement><pen lineWidth="1.5" lineStyle="Double"/></graphicElement>
                </line>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="555" height="24"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[General Ledger Report]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="0" y="26" width="60" height="18"/>
                <text><![CDATA[Office]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="60" y="26" width="495" height="18"/>
                <textFieldExpression><![CDATA[$F{selected_office_name} + " (including offices below it)"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="46" width="60" height="18"/>
                <text><![CDATA[Period]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="60" y="46" width="495" height="18"/>
                <textFieldExpression><![CDATA[new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{startDate}) + " - " + new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{endDate})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="0" width="55" height="20"/>
                <text><![CDATA[Date]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="55" y="0" width="45" height="20"/>
                <text><![CDATA[Entry]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="100" y="0" width="115" height="20"/>
                <text><![CDATA[Contra Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="215" y="0" width="115" height="20"/>
                <text><![CDATA[Description]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="330" y="0" width="75" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Debit]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="405" y="0" width="75" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Credit]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="480" y="0" width="75" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Balance]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField pattern="dd/MM/yyyy">
                <reportElement x="0" y="0" width="55" height="18"/>
                <textFieldExpression><![CDATA[$F{entry_date}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="55" y="0" width="45" height="18"/>
                <textFieldExpression><![CDATA[$F{manual_entry_id} == null ? "System" : String.valueOf($F{manual_entry_id})]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="100" y="0" width="115" height="18"/>
                <textFieldExpression><![CDATA[$F{account_name}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="215" y="0" width="115" height="18"/>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="330" y="0" width="75" height="18"/>
                <textFieldExpression><![CDATA[$F{debit_amount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="405" y="0" width="75" height="18"/>
                <textFieldExpression><![CDATA[$F{credit_amount}]]></textFieldExpression>
            </textField>
            <!-- Running balance: opening balance plus the movements up to and including this row -->
            <textField>
                <reportElement style="Amount" x="480" y="0" width="75" height="18"/>
                <textFieldExpression><![CDATA[$F{opening_balance}.add($V{accountMovement})]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Label" x="0" y="2" width="200" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Printed by " + $P{currentUserName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd MMM yyyy HH:mm">
                <reportElement style="Label" x="200" y="2" width="155" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{currentDateTime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="355" y="2" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="525" y="2" width="30" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="0" width="555" height="40"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font size="11"/></textElement>
                <text><![CDATA[No journal entries for the selected GL account, office and period.]]></text>
            </staticText>
        </band>
    </noData>
</jasperReport>
