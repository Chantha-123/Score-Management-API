<!-- Stretchy report "Obligation Met Loans Details(Pentaho)" (report_type = Jasper).
     Run with R_officeId, R_loanOfficerId, R_currencyId, R_fundId, R_loanProductId, R_loanPurposeId
     (-1 = All; -10 = blank loan officer / fund / purpose), R_obligDateType (1 = closed, 2 = disbursed between the dates),
     R_startDate, R_endDate (yyyy-MM-dd). -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="obligation-met-loans-details-pentaho" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">

    <property name="net.sf.jasperreports.export.pdf.glyph.renderer.blocks" value="khmer"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.title" value="title"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.csv.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.band.pageFooter" value="pageFooter"/>
    <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.columnHeader" value="columnHeader"/>

    <!-- DejaVu Sans with Battambang for Khmer; rows are at least 2x the font size -->
    <style name="Base" isDefault="true" fontName="DejaVu Sans Khmer" fontSize="7"/>
    <style name="Label" style="Base" forecolor="#555555"/>
    <style name="Value" style="Base" isBold="true"/>
    <style name="ColumnHeader" style="Base" isBold="true" mode="Opaque" backcolor="#E6E6E6" vTextAlign="Middle"/>
    <style name="Amount" style="Base" hTextAlign="Right" pattern="#,##0.00"/>
    <style name="Total" style="Amount" isBold="true"/>

    <!-- Supplied by the service on every run -->
    <parameter name="currentDate" class="java.util.Date"/>
    <parameter name="currentDateTime" class="java.util.Date"/>
    <parameter name="currentUserHierarchy" class="java.lang.String"/>
    <parameter name="currentUserName" class="java.lang.String"/>
    <!-- Stretchy parameter variables; defaults apply when the R_ value is missing or blank -->
    <parameter name="officeId" class="java.lang.Long">
        <!-- OfficeIdSelectOne has no "All": default to the head office (root of the hierarchy) -->
        <defaultValueExpression><![CDATA[1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanOfficerId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="currencyId" class="java.lang.String">
        <defaultValueExpression><![CDATA["-1"]]></defaultValueExpression>
    </parameter>
    <parameter name="fundId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanProductId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="loanPurposeId" class="java.lang.Long">
        <defaultValueExpression><![CDATA[-1L]]></defaultValueExpression>
    </parameter>
    <parameter name="obligDateType" class="java.lang.Long">
        <!-- 1 = closed between the dates, 2 = disbursed between the dates; the stretchy default (0) applies no date filter -->
        <defaultValueExpression><![CDATA[0L]]></defaultValueExpression>
    </parameter>
    <parameter name="startDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[$P{currentDate}]]></defaultValueExpression>
    </parameter>
    <parameter name="endDate" class="java.util.Date">
        <defaultValueExpression><![CDATA[$P{currentDate}]]></defaultValueExpression>
    </parameter>

    <queryString>
        <![CDATA[
SELECT o.name AS selected_office_name,
       (SELECT s.display_name FROM m_staff s WHERE s.id = $P{loanOfficerId}) AS filter_loan_officer,
       (SELECT p.name FROM m_product_loan p WHERE p.id = $P{loanProductId}) AS filter_product,
       (SELECT fu.name FROM m_fund fu WHERE fu.id = $P{fundId}) AS filter_fund,
       (SELECT cv.code_value FROM m_code_value cv WHERE cv.id = $P{loanPurposeId}) AS filter_loan_purpose,
       ounder.id AS office_id,
       CONCAT(REPEAT('..', LENGTH(ounder.hierarchy) - LENGTH(REPLACE(ounder.hierarchy, '.', '')) - 1), ounder.name) AS office_name,
       l.currency_code,
       COALESCE(cur.display_symbol, l.currency_code) AS currency,
       c.account_no AS client_account_no,
       c.display_name AS client_name,
       l.account_no AS loan_account_no,
       pl.name AS product_name,
       f.name AS fund_name,
       l.principal_amount AS loan_amount,
       l.total_repayment_derived AS total_repaid,
       l.annual_nominal_interest_rate AS annual_interest_rate,
       l.disbursedon_date AS disbursed_on,
       l.closedon_date AS closed_on,
       l.principal_repaid_derived AS principal_repaid,
       l.interest_repaid_derived AS interest_repaid,
       l.fee_charges_repaid_derived AS fees_repaid,
       l.penalty_charges_repaid_derived AS penalties_repaid,
       lo.display_name AS loan_officer_name
FROM m_office o
JOIN m_office ounder ON ounder.hierarchy LIKE CONCAT(o.hierarchy, '%')
                    AND ounder.hierarchy LIKE CONCAT($P{currentUserHierarchy}, '%')
JOIN m_client c ON c.office_id = ounder.id
JOIN m_loan l ON l.client_id = c.id
JOIN m_product_loan pl ON pl.id = l.product_id
LEFT JOIN m_staff lo ON lo.id = l.loan_officer_id
LEFT JOIN m_currency cur ON cur.code = l.currency_code
LEFT JOIN m_fund f ON f.id = l.fund_id
WHERE o.id = $P{officeId}
  AND ($P{currencyId} = '-1' OR l.currency_code = $P{currencyId})
  AND ($P{loanProductId} = -1 OR l.product_id = $P{loanProductId})
  AND ($P{loanOfficerId} = -1 OR COALESCE(l.loan_officer_id, -10) = $P{loanOfficerId})
  AND ($P{fundId} = -1 OR COALESCE(l.fund_id, -10) = $P{fundId})
  AND ($P{loanPurposeId} = -1 OR COALESCE(l.loanpurpose_cv_id, -10) = $P{loanPurposeId})
  AND (($P{obligDateType} = 1 AND l.closedon_date BETWEEN $P{startDate} AND $P{endDate})
       OR ($P{obligDateType} = 2 AND l.disbursedon_date BETWEEN $P{startDate} AND $P{endDate})
       OR $P{obligDateType} NOT IN (1, 2))
  AND l.loan_status_id = 600
ORDER BY ounder.hierarchy, l.currency_code, c.account_no, l.account_no
        ]]>
    </queryString>

    <field name="selected_office_name" class="java.lang.String"/>
    <field name="filter_loan_officer" class="java.lang.String"/>
    <field name="filter_product" class="java.lang.String"/>
    <field name="filter_fund" class="java.lang.String"/>
    <field name="filter_loan_purpose" class="java.lang.String"/>
    <field name="office_id" class="java.lang.Long"/>
    <field name="office_name" class="java.lang.String"/>
    <field name="currency_code" class="java.lang.String"/>
    <field name="currency" class="java.lang.String"/>
    <field name="client_account_no" class="java.lang.String"/>
    <field name="client_name" class="java.lang.String"/>
    <field name="loan_account_no" class="java.lang.String"/>
    <field name="product_name" class="java.lang.String"/>
    <field name="fund_name" class="java.lang.String"/>
    <field name="loan_amount" class="java.math.BigDecimal"/>
    <field name="total_repaid" class="java.math.BigDecimal"/>
    <field name="annual_interest_rate" class="java.math.BigDecimal"/>
    <field name="disbursed_on" class="java.util.Date"/>
    <field name="closed_on" class="java.util.Date"/>
    <field name="principal_repaid" class="java.math.BigDecimal"/>
    <field name="interest_repaid" class="java.math.BigDecimal"/>
    <field name="fees_repaid" class="java.math.BigDecimal"/>
    <field name="penalties_repaid" class="java.math.BigDecimal"/>
    <field name="loan_officer_name" class="java.lang.String"/>

    <variable name="grandLoanAmount" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{loan_amount}]]></variableExpression>
    </variable>
    <variable name="officeLoanAmount" class="java.math.BigDecimal" resetType="Group" resetGroup="office" calculation="Sum">
        <variableExpression><![CDATA[$F{loan_amount}]]></variableExpression>
    </variable>
    <variable name="grandTotalRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{total_repaid}]]></variableExpression>
    </variable>
    <variable name="officeTotalRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="office" calculation="Sum">
        <variableExpression><![CDATA[$F{total_repaid}]]></variableExpression>
    </variable>
    <variable name="grandPrincipalRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_repaid}]]></variableExpression>
    </variable>
    <variable name="officePrincipalRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="office" calculation="Sum">
        <variableExpression><![CDATA[$F{principal_repaid}]]></variableExpression>
    </variable>
    <variable name="grandInterestRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_repaid}]]></variableExpression>
    </variable>
    <variable name="officeInterestRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="office" calculation="Sum">
        <variableExpression><![CDATA[$F{interest_repaid}]]></variableExpression>
    </variable>
    <variable name="grandFeesRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_repaid}]]></variableExpression>
    </variable>
    <variable name="officeFeesRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="office" calculation="Sum">
        <variableExpression><![CDATA[$F{fees_repaid}]]></variableExpression>
    </variable>
    <variable name="grandPenaltiesRepaid" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{penalties_repaid}]]></variableExpression>
    </variable>
    <variable name="officePenaltiesRepaid" class="java.math.BigDecimal" resetType="Group" resetGroup="office" calculation="Sum">
        <variableExpression><![CDATA[$F{penalties_repaid}]]></variableExpression>
    </variable>

    <!-- Amounts in different currencies are never added together: group by office AND currency -->
    <group name="office">
        <groupExpression><![CDATA[$F{office_id} + "|" + $F{currency_code}]]></groupExpression>
        <groupHeader>
            <band height="20">
                <textField>
                    <reportElement style="Value" x="0" y="2" width="802" height="18"/>
                    <textFieldExpression><![CDATA[$F{office_name} + "  (" + $F{currency} + ")"]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
        <groupFooter>
            <band height="22">
                <line>
                    <reportElement x="511" y="1" width="291" height="1"/>
                    <graphicElement><pen lineWidth="0.5"/></graphicElement>
                </line>
                <textField>
                    <reportElement style="Value" x="0" y="2" width="511" height="18"/>
                    <textElement textAlignment="Right"/>
                    <textFieldExpression><![CDATA["Subtotal " + $F{office_name}.replaceFirst("^(\\.\\.)+", "") + " (" + $F{currency} + "), " + $V{office_COUNT} + " loans"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="511" y="2" width="52" height="18"/>
                    <textFieldExpression><![CDATA[$V{officeLoanAmount}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="563" y="2" width="52" height="18"/>
                    <textFieldExpression><![CDATA[$V{officeTotalRepaid}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="615" y="2" width="48" height="18"/>
                    <textFieldExpression><![CDATA[$V{officePrincipalRepaid}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="663" y="2" width="48" height="18"/>
                    <textFieldExpression><![CDATA[$V{officeInterestRepaid}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="711" y="2" width="45" height="18"/>
                    <textFieldExpression><![CDATA[$V{officeFeesRepaid}]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement style="Total" x="756" y="2" width="46" height="18"/>
                    <textFieldExpression><![CDATA[$V{officePenaltiesRepaid}]]></textFieldExpression>
                </textField>
            </band>
        </groupFooter>
    </group>

    <title>
        <band height="90">
            <staticText>
                <reportElement x="0" y="0" width="802" height="24"/>
                <textElement textAlignment="Center"><font size="13" isBold="true"/></textElement>
                <text><![CDATA[Obligation Met Loans Details]]></text>
            </staticText>
            <staticText>
                <reportElement style="Label" x="0" y="26" width="70" height="18"/>
                <text><![CDATA[Office]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="70" y="26" width="330" height="18"/>
                <textFieldExpression><![CDATA[$F{selected_office_name}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="46" width="70" height="18"/>
                <text><![CDATA[Period]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="70" y="46" width="330" height="18"/>
                <textFieldExpression><![CDATA[$P{obligDateType} == 1L || $P{obligDateType} == 2L
    ? ($P{obligDateType} == 1L ? "Closed " : "Disbursed ")
        + new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{startDate}) + " - "
        + new java.text.SimpleDateFormat("dd MMM yyyy", $P{REPORT_LOCALE}).format($P{endDate})
    : "Any date"]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="420" y="26" width="80" height="18"/>
                <text><![CDATA[Currency]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="500" y="26" width="302" height="18"/>
                <textFieldExpression><![CDATA["-1".equals($P{currencyId}) ? "All" : $P{currencyId}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="420" y="46" width="80" height="18"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <textField>
                <reportElement style="Value" x="500" y="46" width="302" height="18"/>
                <textFieldExpression><![CDATA[$P{loanOfficerId} == -1L ? "All" : $P{loanOfficerId} == -10L ? "(No loan officer)" : $F{filter_loan_officer}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement style="Label" x="0" y="66" width="70" height="18"/>
                <text><![CDATA[Filters]]></text>
            </staticText>
            <textField textAdjust="StretchHeight">
                <reportElement style="Value" x="70" y="66" width="732" height="18"/>
                <textFieldExpression><![CDATA["Product: " + ($P{loanProductId} == -1L ? "All" : $F{filter_product})
    + "     Fund: " + ($P{fundId} == -1L ? "All" : $P{fundId} == -10L ? "(No fund)" : $F{filter_fund})
    + "     Loan Purpose: " + ($P{loanPurposeId} == -1L ? "All" : $P{loanPurposeId} == -10L ? "(No purpose)" : $F{filter_loan_purpose})]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="20">
            <staticText>
                <reportElement style="ColumnHeader" x="0" y="0" width="55" height="20"/>
                <text><![CDATA[Client Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="55" y="0" width="95" height="20"/>
                <text><![CDATA[Client]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="150" y="0" width="55" height="20"/>
                <text><![CDATA[Loan Account]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="205" y="0" width="65" height="20"/>
                <text><![CDATA[Product]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="270" y="0" width="50" height="20"/>
                <text><![CDATA[Fund]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="320" y="0" width="65" height="20"/>
                <text><![CDATA[Loan Officer]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="385" y="0" width="30" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Rate %]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="415" y="0" width="48" height="20"/>
                <text><![CDATA[Disbursed]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="463" y="0" width="48" height="20"/>
                <text><![CDATA[Closed]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="511" y="0" width="52" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Loan Amount]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="563" y="0" width="52" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Total Repaid]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="615" y="0" width="48" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Principal Repaid]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="663" y="0" width="48" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Interest Repaid]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="711" y="0" width="45" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Fees Repaid]]></text>
            </staticText>
            <staticText>
                <reportElement style="ColumnHeader" x="756" y="0" width="46" height="20"/>
                <textElement textAlignment="Right"/>
                <text><![CDATA[Penalties Repaid]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="55" height="18"/>
                <textFieldExpression><![CDATA[$F{client_account_no}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="55" y="0" width="95" height="18"/>
                <textFieldExpression><![CDATA[$F{client_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="150" y="0" width="55" height="18"/>
                <textFieldExpression><![CDATA[$F{loan_account_no}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="205" y="0" width="65" height="18"/>
                <textFieldExpression><![CDATA[$F{product_name}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="270" y="0" width="50" height="18"/>
                <textFieldExpression><![CDATA[$F{fund_name}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight">
                <reportElement x="320" y="0" width="65" height="18"/>
                <textFieldExpression><![CDATA[$F{loan_officer_name}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="385" y="0" width="30" height="18"/>
                <textFieldExpression><![CDATA[$F{annual_interest_rate}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="415" y="0" width="48" height="18"/>
                <textFieldExpression><![CDATA[$F{disbursed_on}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy">
                <reportElement x="463" y="0" width="48" height="18"/>
                <textFieldExpression><![CDATA[$F{closed_on}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="511" y="0" width="52" height="18"/>
                <textFieldExpression><![CDATA[$F{loan_amount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="563" y="0" width="52" height="18"/>
                <textFieldExpression><![CDATA[$F{total_repaid}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="615" y="0" width="48" height="18"/>
                <textFieldExpression><![CDATA[$F{principal_repaid}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="663" y="0" width="48" height="18"/>
                <textFieldExpression><![CDATA[$F{interest_repaid}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="711" y="0" width="45" height="18"/>
                <textFieldExpression><![CDATA[$F{fees_repaid}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Amount" x="756" y="0" width="46" height="18"/>
                <textFieldExpression><![CDATA[$F{penalties_repaid}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="18">
            <textField>
                <reportElement style="Label" x="0" y="2" width="300" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Printed by " + $P{currentUserName}]]></textFieldExpression>
            </textField>
            <textField pattern="dd MMM yyyy HH:mm">
                <reportElement style="Label" x="300" y="2" width="200" height="14"/>
                <textElement textAlignment="Center"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$P{currentDateTime}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Label" x="602" y="2" width="170" height="14"/>
                <textElement textAlignment="Right"><font size="7"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER} + " of"]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report">
                <reportElement style="Label" x="772" y="2" width="30" height="14"/>
                <textElement><font size="7"/></textElement>
                <textFieldExpression><![CDATA[" " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="26">
            <line>
                <reportElement x="0" y="2" width="802" height="1"/>
            </line>
            <textField>
                <reportElement style="Value" x="0" y="5" width="511" height="18"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Grand total, " + $V{REPORT_COUNT} + " loans"]]></textFieldExpression>
            </textField>
            <!-- Only a single currency can be summed into one grand total -->
            <textField>
                <reportElement style="Total" x="511" y="5" width="52" height="18">
                    <printWhenExpression><![CDATA[!"-1".equals($P{currencyId})]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$V{grandLoanAmount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Total" x="563" y="5" width="52" height="18">
                    <printWhenExpression><![CDATA[!"-1".equals($P{currencyId})]]></printWhenExpression>
                </reportElement>
                <textFieldExpression><![CDATA[$V{grandTotalRepaid}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="Total" x="615" y="5" width="48" height="18">
                    <printWhenExpression><![CDATA[!"-1".equals($P{currencyId})]]></printWhenExpression>
                </reportElement>
