# Copied to .env by start.ps1 / start.sh on first run (passwords are generated).
# Choose passwords BEFORE the first start: changing DB_PASSWORD later breaks the
# API because the DB user and tenant connection row are created only once.
DB_ROOT_PASSWORD=
DB_PASSWORD=
TENANT_TIMEZONE=Asia/Bangkok

# 0.0.0.0 = reachable from other laptops on the LAN; 127.0.0.1 = this laptop only.
BIND_ADDRESS=0.0.0.0
WEB_PORT=9002
API_PORT=8443
API_HEAP=2g

# Database port for DBeaver/SQL clients. Kept separate from BIND_ADDRESS so the DB
# stays private by default; set DB_BIND_ADDRESS=0.0.0.0 to reach it from other PCs.
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=3306

PROJECT_NAME=score-test
# Images: IMAGE_REPO:db-IMAGE_TAG, :api-IMAGE_TAG, :frontend-IMAGE_TAG (pulled on start).
# To update, set IMAGE_TAG to the newly pushed version and run start again.
IMAGE_REPO=pichoudam/mini_pawnshop_v1
IMAGE_TAG=1.0.2
