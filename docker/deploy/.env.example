# Copied to .env by start.ps1 / start.sh on first run (passwords are generated).
# Choose passwords BEFORE the first start: changing DB_PASSWORD later breaks the
# API because the DB user and tenant connection row are created only once.
DB_ROOT_PASSWORD=
DB_PASSWORD=
TENANT_TIMEZONE=Asia/Bangkok

# 0.0.0.0 = reachable from other laptops on the LAN; 127.0.0.1 = this laptop only.
BIND_ADDRESS=0.0.0.0
WEB_PORT=9002
API_PORT=8443
API_HEAP=2g

PROJECT_NAME=score-test
API_IMAGE=mini-pawnshop-api
FRONTEND_IMAGE=mini-pawnshop-frontend
DB_IMAGE=mini-pawnshop-db
IMAGE_TAG=local
